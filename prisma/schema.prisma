// ============================================================
// ezPLM AI 供应链协同系统 — Prisma Schema(PR2 基线)
// 基线依据:docs/SPEC.md §4(43 模型,唯一真源)+ docs/SCHEMAMERGEMAP.md(BASELINE)
// 评审要求:PR1 评审意见 二.1–二.10(2026-07-27)
//
// 全局纪律:
// - 多租户:所有业务表带 tenantId;唯一约束一律 tenant-scoped
//   (@@unique([tenantId, ...]),无全局业务 unique);高频查询建 (tenantId, ...) 复合索引。
// - FK 纪律(评审备案 B,后续 PR 不得随手偏离):
//   聚合内子表用 FK 关系(RFQ→附件/历史、BOM→版本→行→候选/决定、Offer→阶梯、
//   Quote→版本→行/审批、ProcurementRFQ→报价→行、OPO→回复、AgentRun→步骤/证据/确认);
//   跨聚合引用(tenantId/userId/customerId/supplierId/partId/candidateId/previousLineId 等)
//   一律受控标量:租户隔离由应用层 tenant scope + 复合唯一约束保证,
//   审计/Agent 记录必须比 User 行长寿(用户只停用不删除),故不设用户 FK。
// - 金额/单价/费率/数量一律 Decimal,禁止 Float;币种独立字段(ISO 4217)。
// - 数据主权:ezPLM = 物料主数据/库存/工程文件唯一真源(本系统只读缓存);
//   本系统 = RFQ/报价/采购比价/OPO 流程唯一真源。禁止双写。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7:连接串不在 schema 中,见根目录 prisma.config.ts(env DATABASE_URL)
datasource db {
  provider = "postgresql"
}

// ============================================================
// 枚举
// ============================================================

/// 角色固定五值(CLAUDE.md:无"销售主管/总经理/品质"等其它审批角色)
enum RoleName {
  PM
  PROCUREMENT
  ENGINEERING
  MANAGEMENT
  SUPPLIER
}

/// 物料来源。**数据主权的落地点**:
/// EZPLM 行是只读缓存(禁止本系统改写),其余三种是本系统自己的数据。
enum PartOrigin {
  /// ezPLM 同步来的只读缓存(唯一真源在 ezPLM)
  EZPLM
  /// 本系统手工创建(ezPLM 里没有的料)
  LOCAL
  /// 从用户自有系统批量导入
  IMPORTED
  /// 从 ERP 同步而来
  ERP
}

/// 自建物料的生命状态(与器件 lifecycle 是两回事:一个说流程,一个说停产与否)
enum PartStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  DISABLED
  /// 已淘汰:与 DISABLED 区分 —— DISABLED 是"暂时停用,可能恢复",
  /// OBSOLETE 是"永久淘汰,不再采购"。两者对 BOM 与采购的含义不同
  OBSOLETE
}

/// 合规声明结论(PR-F)。
/// 原实现是 Part 上的 Boolean —— 无法表达"不适用"与"未知"的区别,
/// 也承载不了"凭哪份文档、什么版本、谁审的、何时到期"。
enum ComplianceVerdict {
  COMPLIANT
  NON_COMPLIANT
  /// 不适用(如纯机构件谈 REACH 无意义)
  NOT_APPLICABLE
  /// **未知**:没有依据。与 NON_COMPLIANT 必须分开 —— 不知道不等于不合规
  UNKNOWN
}

/// 合规声明的审核状态
enum ComplianceReviewState {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

/// 物料属性的数据类型(分类驱动的动态参数)
enum PartAttrType {
  TEXT
  NUMBER
  RANGE
  ENUM
  BOOLEAN
}

/// 文档种类(合规与文档区)
enum PartDocKind {
  DATASHEET
  APPROVAL_SHEET
  ROHS_REPORT
  REACH_REPORT
  COC
  OTHER
}

/// 重复检查的处置(疑似重复时**不允许静默创建**)
enum DuplicateResolution {
  USE_EXISTING
  MAP_CUSTOMER_PN
  CREATE_ANYWAY
}

/// 重试退避策略
enum RetryBackoff {
  /// 固定间隔
  FIXED
  /// 指数退避(推荐:外部系统故障时不加剧其压力)
  EXPONENTIAL
  /// 不重试
  NONE
}

/// ERP 厂商。业务代码**不得**判断具体厂商,一律走 ErpProvider 接口。
enum ErpVendor {
  KINGDEE
  YONYOU
  SAP
  ORACLE
  EXCEL
  MOCK
  /// F4:ERP 仿真环境(gongyueetree/ezplm-erp-lab)。联调目标,**不是金蝶** —— UI 必须标「仿真」
  ERP_LAB
}

/// 连接状态。**CONNECTED 只能在真实请求成功后写入** —— 不接受固定绿灯。
enum ErpConnectionStatus {
  NOT_CONFIGURED
  PENDING_TEST
  CONNECTED
  DEGRADED
  FAILED
  DISABLED
}

/// 同步方向。受数据主权约束:ezPLM 为主数据源的实体不接受本系统覆盖。
enum ErpSyncDirection {
  ERP_TO_EZPLM
  EZPLM_TO_ERP
  BIDIRECTIONAL
  IMPORT_ONLY
  EXPORT_TEMPLATE_ONLY
}

/// 同步实体
enum ErpEntityType {
  MATERIAL
  INVENTORY
  OPEN_PO
  WORK_ORDER
  PURCHASE_ORDER
  ETA_WRITEBACK
  RECEIPT_LOT
  SHIPMENT
  // ---- F4:ERP Lab 合约覆盖的实体(Excess/FX/往来单位;AR/AP 仅预留状态位)----
  EXCESS
  FX_RATE
  SUPPLIER
  CUSTOMER
  AR_AP
}

/// 冲突处理策略
enum ErpConflictPolicy {
  STOP_ON_CONFLICT
  SKIP_ON_CONFLICT
  QUEUE_FOR_HUMAN
}

/// 行级同步结果
enum ErpLineOutcome {
  CREATED
  UPDATED
  UNCHANGED
  CONFLICT
  SKIPPED
  FAILED
}

/// 追溯数据来源。**没有 MES**,所以一期只有导入与 ERP 同步两条真实通道。
enum TraceSource {
  IMPORT
  ERP_SYNC
  MANUAL
  MES
}

/// 追溯图的边类型(供应链正向顺序)
enum TraceEdgeKind {
  PO_TO_RECEIPT
  RECEIPT_TO_LOT
  LOT_TO_ISSUE
  ISSUE_TO_WORK_ORDER
  WORK_ORDER_TO_FG_LOT
  FG_LOT_TO_SHIPMENT
  SHIPMENT_TO_CUSTOMER
  /// 批次拆分:一个批次拆成多个子批次(图必须保持连续,否则追溯在拆分处会断)
  LOT_SPLIT
  /// 批次合并:多个批次并成一个新批次
  LOT_MERGE
}

/// 追溯事件类型(PR-E)。
/// 原字段是自由字符串,无法做统计与筛选;改为受控枚举并**保留原字段**兼容历史数据。
enum TraceEventKind {
  RECEIVED
  ISSUED
  RETURNED
  PRODUCED
  SHIPPED
  REWORK
  REPAIR
  SCRAP
  RETURN
  RETEST
  REPACKAGE
  SPLIT
  MERGE
  FREEZE
  UNFREEZE
  OTHER
}

/// 数据完整度评级(Blast Radius 用)
enum TraceConfidence {
  HIGH
  MEDIUM
  LOW
}

/// 质量事件状态
enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  CLOSED
}

/// 处置动作类型
enum ContainmentKind {
  FREEZE_LOT
  PAUSE_WORK_ORDER
  MARK_RECHECK
  DRAFT_RMA
  NOTIFY_SUPPLIER
  NOTIFY_CUSTOMER
  CREATE_CAPA
  RECALL_ASSESSMENT
  EXPORT_QUARANTINE_LIST
}

/// 处置执行状态。
/// **本系统只能登记,外部系统是否执行是另一回事** —— 绝不用一个「已完成」糊过去。
enum ContainmentState {
  SUGGESTED
  PENDING_APPROVAL
  REGISTERED_LOCALLY
  PENDING_EXTERNAL
  EXTERNAL_CONFIRMED
  FAILED
  REJECTED
}

/// RFQ 状态机(SPEC §5)
enum RfqStatus {
  DRAFT
  RECEIVED
  PARSING
  WAITING_ENGINEERING
  WAITING_PROCUREMENT
  QUOTING
  PENDING_APPROVAL
  QUOTED
  CLOSED_NO_QUOTE
  LOST
}

/// 报价状态机(CLAUDE.md 领域规则,与评审要求二.4 完全一致)
enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
}

/// 报价成本分类(SPEC §12:材料/人工/NRE/SMT/DIP/测试/管理费/其它)
enum QuoteCostCategory {
  MATERIAL
  LABOR
  NRE
  SMT
  DIP
  TEST
  OVERHEAD
  OTHER
}

/// 附件类型(SPEC §5)
enum AttachmentType {
  BOM
  GERBER
  PDF
  IMAGE
  PROCESS_DOC
  OTHER
}

/// 通用作业状态机(ImportJob/AgentRun/IntegrationJob/ReminderLog)
enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  /// 部分成功:有行成功也有行失败。**不能用 FAILED 冒充** ——
  /// 否则重跑会把已成功的行再写一遍,或让人误以为整批没进去。
  PARTIAL_SUCCESS
  /// 已安排重试(nextRetryAt 到点后由调度或人工触发)
  RETRYING
  /// 重试次数耗尽,转人工。**不再自动重试**,避免无限打外部系统
  DEAD_LETTER
}

/// 元器件生命周期
enum Lifecycle {
  ACTIVE
  NRND
  EOL
  OBSOLETE
  UNKNOWN
}

/// 外部数据/报价来源(SPEC §7–§10;OFFLINE=线下供应商 Excel)
enum ProviderType {
  EZPLM
  DIGIKEY
  MOUSER
  OFFLINE
  /// 本系统自建(不是任何外部源的缓存)
  LOCAL
}

/// BOM 匹配候选来源,顺序对应 SPEC §6 匹配顺序
enum MatchSource {
  CUSTOMER_MAPPING
  INTERNAL_PN
  EXACT_MPN
  MFR_MPN
  DESCRIPTION
  /// 本地物料库按型号+封装相似度找出的候选(工程 BOM 只有 Value 时的主力)
  LOCAL_SIMILAR
  /// ezPLM 检索 + 相似度排序得到的候选
  EZPLM_SIMILAR
  EZPLM
  DIGIKEY
  MOUSER
  MANUAL
}

/// BOM 行人工确认结论(AI 只建议,不落定)
enum LineDecisionType {
  ACCEPT_CANDIDATE
  MANUAL_ASSIGN
  NO_MATCH
}

/// 审批/确认结论(QuoteApproval / AgentApproval)
enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

/// 采购 RFQ 流程状态
enum ProcurementRfqStatus {
  DRAFT
  SOURCING
  FEEDBACK_READY
  CLOSED
}

/// 现货/期货模式(SPEC §11)
enum SourcingMode {
  SPOT
  FUTURES
}

/// 报价行异常处理结论(默认空、逐项人工选;CLAUDE.md 异常处理闭环)
enum FlagResolution {
  ACCEPT
  REQUOTE
  SWITCH_SOURCE
  ADJUST_PRICE
}

/// PM 采购申请单状态
enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  CLOSED
}

/// 对账类型:AR = 应收(对客户,PM 侧);AP = 应付(对供应商,采购侧)
enum ReconciliationKind {
  AR
  AP
}

enum ReconciliationStatus {
  DRAFT
  MATCHED
  CONFIRMED
  CLOSED
}

/// 我方基准来源。**本系统不拥有出货/入库数据**(属 ERP 数据主权),
/// 故基准要么由本系统已有单据派生,要么由 ERP 导出明细上传。
enum ReconBaselineSource {
  DERIVED
  UPLOADED
}

/// 对账行判定(与 lib/domain/recon-match.ts 的 verdict 一一对应)
enum ReconLineVerdict {
  CONSISTENT
  QTY_DIFF
  PRICE_DIFF
  AMOUNT_DIFF
  CURRENCY_MISMATCH
  ONLY_THEIRS
  ONLY_OURS
}

/// 采购订单状态(见 lib/domain/po-status.ts 的状态机)。
/// 注意:**没有「已下单」** —— ERP 才是下单执行的真源,本系统只到
/// APPROVED(已审批·待 ERP 录入)与 EXPORTED(已导出 ERP 可导入模板)。
enum PurchaseOrderStatus {
  DRAFT
  PENDING_PRICE_REVIEW
  PENDING_APPROVAL
  APPROVED
  EXPORTED
  REJECTED
  CANCELLED
}

/// PO 审批环节:价格复核 与 终审 是两道不同的关
enum PoApprovalStage {
  PRICE_REVIEW
  FINAL
}

/// OPO 供应商回复渠道
enum ReplySource {
  EMAIL
  PORTAL
  EXCEL
  PHONE
  MANUAL
  /// F3:供应商经免登录确认链接提交
  LINK
}

/// 智能体类型(SPEC §13)
enum AgentType {
  RFQ_INTAKE
  BOM_MATCHING
  SOURCING
  QUOTE
  OPO
  /// 追溯影响面分析:只出建议与证据,禁止自动冻结/通知/召回
  TRACE
}

/// 集成作业类型(ERP Excel 模板兜底路径等)
enum IntegrationJobType {
  ERP_ORDER_EXPORT
  ERP_ETA_WRITEBACK
  EMAIL_SEND
  OPO_REMINDER
  OTHER
}

// ============================================================
// 1. 租户与主体
// ============================================================

/// 租户。融合钉子:ezplmTenantId 可空,将来对接 ezPLM 本体租户(禁止现在就依赖)
model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  /// 融合字段(可空):对应 ezPLM 本体租户 ID,SSO/数据映射用
  ezplmTenantId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users User[]
}

/// 用户。本地账号体系;externalUserId 为 SSO 融合预留(JWT 验签适配器)
model User {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  email          String
  name           String
  /// 本地认证口令哈希(argon2/bcrypt);SSO 用户可空
  passwordHash   String?
  /// 融合字段(可空):ezPLM 侧用户 ID,JWT 验签后映射
  externalUserId String?
  /// 供应商账号归属(跨聚合引用,受控标量)。
  /// SUPPLIER 角色**必须**有此归属,否则追溯查询一律拒绝 ——
  /// 没有归属就无法判断"与自身相关",宁可不给数据也不给全量。
  supplierId     String?
  /// 用户只停用不删除(审计记录长寿要求)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId, externalUserId])
  @@index([tenantId, supplierId])
}

/// 角色目录(tenant-scoped;name 限定五值枚举)
model Role {
  id        String   @id @default(cuid())
  tenantId  String
  name      RoleName
  createdAt DateTime @default(now())

  userRoles UserRole[]

  @@unique([tenantId, name])
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, userId, roleId])
  @@index([tenantId, userId])
}

/// 客户(如示例数据中的联创科技)
/// 客户等级(客户 xlsx:「A/B/C 类客户差异化报价规则配置」)。
/// 三档;**具体 Markup 数值不写死在代码里**,由 QuoteTemplate 维护并标注口径是否已确认。
enum CustomerTier {
  A
  B
  C
}

model Customer {
  id        String        @id @default(cuid())
  tenantId  String
  code      String
  name      String
  /// 客户等级;未评级时为空 —— **空不等于 C**,不猜
  tier      CustomerTier?
  contact   String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

/// 供应商;priority 供 rankOffers 使用(数值越小优先级越高)
model Supplier {
  id              String   @id @default(cuid())
  tenantId        String
  code            String
  name            String
  defaultCurrency String   @default("CNY")
  /// 供应商优先级(rankOffers 排名因子之一)
  priority        Int      @default(100)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts SupplierContact[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

/// 供应商联系人(供应商邮件建档回填目标)
model SupplierContact {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  name       String
  email      String?
  phone      String?
  title      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId, supplierId])
}

// ============================================================
// 2. RFQ 域(本系统唯一真源)
// ============================================================

model RFQ {
  id           String    @id @default(cuid())
  tenantId     String
  code         String
  customerId   String
  title        String
  status       RfqStatus @default(DRAFT)
  /// 报价数量(客户询价的阶梯数量,如 [100, 500, 1000])
  quoteQtys    Json?
  dueAt        DateTime?
  /// "不报价并关闭"原因
  closedReason String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attachments   RFQAttachment[]
  statusHistory RFQStatusHistory[]
  boms          BOM[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

/// 附件保留原始客户文件;fileKey 指向 FileStorageProvider
model RFQAttachment {
  id           String         @id @default(cuid())
  tenantId     String
  rfqId        String
  rfq          RFQ            @relation(fields: [rfqId], references: [id])
  type         AttachmentType @default(OTHER)
  fileName     String
  /// 存储键(FileStorageProvider 抽象;Vercel Blob 或本地)
  fileKey      String
  sizeBytes    Int?
  contentType  String?
  /// E1b:**保存**与**解析**是两件事。
  /// UPLOADED_NOT_PARSED = 存下来了但我们没读它 —— 比假装解析成功诚实,
  /// 也比因为解析不了就让上传失败有用(客户明确要求附件仍要保存成功)。
  processState String         @default("UPLOADED_NOT_PARSED")
  /// 未解析/解析失败的原因原文,直接显示给用户
  processNote  String?
  uploadedById String
  createdAt    DateTime       @default(now())

  @@index([tenantId, rfqId])
}

model RFQStatusHistory {
  id          String     @id @default(cuid())
  tenantId    String
  rfqId       String
  rfq         RFQ        @relation(fields: [rfqId], references: [id])
  fromStatus  RfqStatus?
  toStatus    RfqStatus
  note        String?
  changedById String
  createdAt   DateTime   @default(now())

  @@index([tenantId, rfqId, createdAt])
}

// ============================================================
// 3. BOM 域
// ============================================================

/// 预 BOM(报价用)与正式 BOM(量产用)。客户 Q4 答复:分两套 + 一键转换。
enum BOMPurpose {
  PRE_QUOTE
  PRODUCTION
}

model BOM {
  id                 String     @id @default(cuid())
  tenantId           String
  rfqId              String?
  rfq                RFQ?       @relation(fields: [rfqId], references: [id])
  customerId         String?
  name               String
  /// 用途。默认 PRE_QUOTE:BOM 大多从询价进来,而**正式 BOM 必须是人显式转出来的**,
  /// 不能因为默认值把一份没核对过内部料号的表当成量产依据。
  purpose            BOMPurpose @default(PRE_QUOTE)
  /// 转换溯源:正式 BOM 由哪份预 BOM 转来。**转换生成新 BOM,禁止原地改 purpose** ——
  /// 否则"当初按哪份 BOM 报的价"永远答不上来。
  convertedFromBomId String?
  convertedFromBom   BOM?       @relation("BomConversion", fields: [convertedFromBomId], references: [id])
  convertedTo        BOM[]      @relation("BomConversion")
  convertedAt        DateTime?
  convertedById      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  versions BOMVersion[]

  @@index([tenantId, rfqId])
  @@index([tenantId, purpose])
}

model BOMVersion {
  id            String   @id @default(cuid())
  tenantId      String
  bomId         String
  bom           BOM      @relation(fields: [bomId], references: [id])
  versionNo     Int
  /// 原始导入文件(保留原始客户文件)
  sourceFileKey String?
  note          String?
  /// F2:由哪个 ECN 的 Apply to BOM 生成(版本图谱据此标 ECO 分支);跨聚合标量
  ecnId         String?
  createdById   String
  createdAt     DateTime @default(now())

  lines             BOMLine[]
  manufacturingInfo BomVersionManufacturingInfo[]

  @@unique([tenantId, bomId, versionNo])
}

/// BOM 行;qty 用 Decimal(胶/锡膏等可计量物料)
model BOMLine {
  id                String     @id @default(cuid())
  tenantId          String
  bomVersionId      String
  bomVersion        BOMVersion @relation(fields: [bomVersionId], references: [id])
  lineNo            Int
  /// 位号列表原文(如 "R1,R2,R5");重复位号校验对象
  refDes            String?
  qty               Decimal    @db.Decimal(18, 4)
  customerPn        String?
  mpn               String?
  manufacturer      String?
  description       String?
  footprint         String?
  /// 从封装串归一出的封装代码(0603 / SOT-23-5 / QFN-32);原始 footprint 保留不动
  packageCode       String?
  /// MPN 来源:column = 文件里有独立 MPN 列;inferred-from-value = 从 Value 列推断,**须人工确认**
  mpnSource         String?
  /// 内部料号(转正式 BOM 时匹配写入)。**匹配不到就留空**,不自动建料 ——
  /// ezPLM 是物料主数据唯一真源,本系统只读。
  internalPartId    String?
  internalPn        String?
  /// 匹配来源:CUSTOMER_PN_MAPPING / MPN_EXACT。页面必须显示它,
  /// 否则没人知道这个内部料号是怎么来的。
  internalPnSource  String?
  /// 未匹配时的原因原文(含"多颗候选,系统不替你选"这类),直接显示给人看
  internalPnNote    String?
  /// 导入校验结果(事实性标记,导入完成时一次性写入)
  dupRefDesFlag     Boolean    @default(false)
  eolFlag           Boolean    @default(false)
  footprintMismatch Boolean    @default(false)
  createdAt         DateTime   @default(now())

  matchCandidates BomMatchCandidate[]
  decisions       BomLineDecision[]

  @@unique([tenantId, bomVersionId, lineNo])
  @@index([tenantId, mpn])
}

/// F7(T2,Feature Flag `bom.manufacturingInfo`):BOM 版本的制造工程信息。
///
/// 只做**数据模型与只读展示 + 表单录入**;工艺变更审批/参数校验属工艺流程,
/// 本轮不做(页面注明)。四张卡各存一个 Json 组,字段按静态页归类 ——
/// 结构未经客户确认前不拆成硬列,免得建错列再迁移。
model BomVersionManufacturingInfo {
  id           String     @id @default(cuid())
  tenantId     String
  bomVersionId String
  bomVersion   BOMVersion @relation(fields: [bomVersionId], references: [id])
  /// 工艺路线:[{seq, process, workCenter, taktSeconds, keyParams}]
  processRoute Json?
  /// 拼板规格:[{label, value}]
  panelization Json?
  /// 钢网:[{label, value}]
  stencil      Json?
  /// 工装治具与程序版本:[{label, value}]
  tooling      Json?
  note         String?
  updatedById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tenantId, bomVersionId])
}

/// 大 BOM(>50 唯一 MPN)分批处理;幂等键防重复导入
model BOMImportJob {
  id             String    @id @default(cuid())
  tenantId       String
  bomId          String?
  rfqId          String?
  status         JobStatus @default(PENDING)
  idempotencyKey String
  /// 原始上传文件键列表(多文件批量)
  fileKeys       Json?
  /// 上传时的**原始文件名**列表。存储键带 UUID,看不出用户传的是哪个文件,
  /// 而客户要的正是"追溯过往上传 BOM 文件",故单独留存。
  fileNames      Json?
  totalLines     Int       @default(0)
  processedLines Int       @default(0)
  batchSize      Int       @default(20)
  /// 列映射配置(非标准 BOM → 标准结构)
  columnMapping  Json?
  /// E1a:行去向对账汇总(ImportReconciliation)。**与 RawBomRow 同事务写入**,
  /// 页面直接读它,不在展示时重算 —— 重算会因为解析器升级而与当时的结论对不上。
  reconciliation Json?
  /// 表头之后的原始行数。与 RawBomRow 条数必须相等,不等即为缺陷。
  rawRowCount    Int?
  error          String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rawRows RawBomRow[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
}

// ============================================================
// 4. 物料域(ezPLM 只读真源 + 本地缓存)
// ============================================================

/// 物料主数据镜像。
/// ⚠ 数据主权:ezPLM 为物料主数据唯一真源,本表是只读缓存语义 ——
/// 仅由 Provider 同步通道写入(记录 AuditLog),业务代码禁止直接改写主数据字段,禁止双写回 ezPLM。
/// 守卫(评审备案 C):Part 行仅经 ezPLM 同步通道创建(internalPn 必有);
/// sourcedFrom 仅作溯源,不作为 DigiKey/Mouser 创建 Part 行的许可 ——
/// 外部源数据只落 ExternalPartSnapshot / BomMatchCandidate / SupplierOffer(应用层守卫,PR3 实现)。
model Part {
  id                   String       @id @default(cuid())
  tenantId             String
  internalPn           String
  mpn                  String?
  manufacturer         String?
  description          String?
  footprint            String?
  lifecycle            Lifecycle    @default(UNKNOWN)
  /// 物料分类两级(客户 docx:仅一级大类不够,IC 要能细分到 MCU/USB/电源 IC)。
  /// **本地人工维护**:ezPLM 的 category 只作建议来源,映射不确定时留空,不猜。
  categoryL1           String?
  categoryL2           String?
  /// DC/MSL/包装字段(整合方案 3.2,客户需求)
  dateCode             String?
  msl                  String?
  packaging            String?
  rohs                 Boolean?
  reach                Boolean?
  /// 英文描述 / 品牌 / 备注(手工建料需要,ezPLM 不一定提供)
  descriptionEn        String?
  brand                String?
  note                 String?
  /// N-12:标准成本(STD 价)。损耗报告要按金额分析,靠的就是它。
  /// **可空且不设默认** —— 没维护标准价时报表显示「未维护」而不是按 0 算,
  /// 按 0 算会让损耗金额凭空变成 0,反而掩盖问题。
  standardCost         Decimal?     @db.Decimal(18, 6)
  standardCostCurrency String?
  /// **来源与流程状态**:origin=EZPLM 的行是只读缓存,改写接口必须拒绝
  origin               PartOrigin   @default(EZPLM)
  status               PartStatus   @default(ACTIVE)
  /// 缓存来源与时点(只读缓存语义的一部分)
  sourcedFrom          ProviderType @default(EZPLM)
  syncedAt             DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  identifiers PartIdentifier[]
  alternates  PartAlternate[]  @relation("PartToAlternates")
  alternateOf PartAlternate[]  @relation("AlternateToParts")

  tagLinks               PartTagLink[]
  complianceDeclarations PartComplianceDeclaration[]
  processAttr            PartProcessAttr?
  attrValues             PartAttributeValue[]
  documents              PartDocument[]
  supplierRefs           PartSupplierRef[]
  creationRecord         PartCreationRecord?

  @@unique([tenantId, internalPn])
  @@index([tenantId, mpn])
  @@index([tenantId, manufacturer, mpn])
  @@index([tenantId, categoryL1, categoryL2])
  @@index([tenantId, origin, status])
}

/// SMT 工艺属性(客户 docx:「SMT 工艺字段:包装规格、MSL 湿敏等级、盘装数量」)。
///
/// **为什么单独一张表**:Part 是 ezPLM 只读缓存,schema 纪律禁止业务代码改写主数据字段;
/// 而实测真实 ezPLM 接口**不提供** MSL/包装/DC(只有 Mock 有)。
/// 这些又本来就是本厂自己的工艺数据 —— 所以本地维护、与只读缓存分离,
/// 展示时本地值优先、缺失回落缓存值,并标注取自哪一侧。
model PartProcessAttr {
  id           String   @id @default(cuid())
  tenantId     String
  /// 一对一:每颗料至多一份本地工艺属性
  partId       String   @unique
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  /// 湿敏等级 MSL1–MSL6
  msl          String?
  /// 包装规格:T&R / Tray / Tube / Bulk 等
  packaging    String?
  /// 盘装数量(每盘颗数)
  reelQty      Int?
  /// 供应参数(手工建料时录入的**初始参考**,不是正式采购条件)
  moq          Int?
  spq          Int?
  leadTimeDays Int?
  safetyStock  Decimal? @db.Decimal(18, 4)
  note         String?
  updatedById  String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([tenantId, partId])
}

/// 内部料号编码规则(PR-F)。
///
/// 原实现把规则写死在提示文案里(`EE-[类别]-[型号]`),
/// 换个租户就不适用。改为**按租户可配**,并支持预览下一个编号。
model PartCodeRule {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  /// 固定前缀,如 EE
  prefix          String
  /// 是否把一级分类码拼进去
  includeCategory Boolean  @default(true)
  /// 分隔符
  separator       String   @default("-")
  /// 流水号位数(不足补零)
  sequenceWidth   Int      @default(4)
  /// 当前流水号水位(每次发号 +1)
  currentSequence Int      @default(0)
  /// 是否允许人工指定料号(关掉即强制走自动编码)
  allowManual     Boolean  @default(true)
  /// 仅对某个一级分类生效;空=通用规则
  categoryL1      String?
  isDefault       Boolean  @default(false)
  enabled         Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, categoryL1, enabled])
}

/// 合规**声明**(PR-F)。
///
/// 与支撑文档彻底分离:
/// - 一个声明可由**多份**文档支撑(报告 + COC + 检测数据);
/// - 声明本身有版本、有效期、审核记录;
/// - 结论区分 合规 / 不合规 / 不适用 / **未知** —— 未知不等于不合规。
///
/// Part 上的 rohs / reach 布尔字段**保留不动**(兼容历史),
/// 新逻辑一律读本表;两者并存期间以本表为准。
model PartComplianceDeclaration {
  id           String                @id @default(cuid())
  tenantId     String
  partId       String
  part         Part                  @relation(fields: [partId], references: [id], onDelete: Cascade)
  /// ROHS / REACH / COC / HALOGEN_FREE / CONFLICT_MINERALS 等
  scheme       String
  verdict      ComplianceVerdict     @default(UNKNOWN)
  /// 声明版本号,便于"同一物料的第 2 版 RoHS 声明"
  version      String?
  /// 声明依据的标准与限值说明
  standard     String?
  note         String?
  issuedAt     DateTime?
  validUntil   DateTime?
  state        ComplianceReviewState @default(DRAFT)
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  /// 外部来源(与 PR-E 同一套字段口径)
  sourceSystem String?
  externalId   String?
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  documents PartComplianceEvidence[]

  @@unique([tenantId, partId, scheme, version])
  @@index([tenantId, partId, scheme])
  @@index([tenantId, validUntil])
  @@index([tenantId, state])
}

/// 声明 ↔ 支撑文档的关联(多对多)。
/// 同一份 COC 可同时支撑 RoHS 与 REACH 两个声明,故不能把文档挂死在声明下。
model PartComplianceEvidence {
  id            String                    @id @default(cuid())
  tenantId      String
  declarationId String
  declaration   PartComplianceDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  documentId    String
  document      PartDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  note          String?
  createdById   String
  createdAt     DateTime                  @default(now())

  @@unique([tenantId, declarationId, documentId])
  @@index([tenantId, documentId])
}

/// 自定义物料分类标签(客户 docx:要能自定义「国产替代物料」「关键 A 类客户物料」这类分组)。
/// 标签是**租户自己维护的目录**,不是从外部同步来的,故可增删改。
model PartTag {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// 展示色(CSS 变量名或色值);留空用默认
  color       String?
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  links PartTagLink[]

  @@unique([tenantId, name])
}

model PartTagLink {
  id          String   @id @default(cuid())
  tenantId    String
  partId      String
  part        Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  tagId       String
  tag         PartTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdById String
  createdAt   DateTime @default(now())

  @@unique([tenantId, partId, tagId])
  @@index([tenantId, tagId])
}

/// BOM 版本比对台账(客户 docx:「增加历史比对记录台账,每次比对需要重新选择版本,历史快照留存」)。
/// 存的是**当时的比对快照**:两个版本之后再改也不影响已存的记录。
model BomCompareRun {
  id               String   @id @default(cuid())
  tenantId         String
  fromVersionId    String
  toVersionId      String
  /// 便于台账直接显示,不必回查
  label            String
  addedCount       Int
  removedCount     Int
  qtyChangedCount  Int
  partChangedCount Int
  unchangedCount   Int
  /// 差异明细快照
  snapshot         Json
  createdById      String
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, fromVersionId, toVersionId])
}

/// 权限授予(角色 → 权限串)。
///
/// 现有模型只有 5 个角色枚举,没有权限体系,也没有"系统管理员"。
/// 这里用**权限串 + 按租户授予**来表达细粒度权限,而不是新增一个与既有架构冲突的硬编码角色
/// —— 「系统管理员」= MANAGEMENT + erp.connection.manage 这类组合。
model PermissionGrant {
  id          String   @id @default(cuid())
  tenantId    String
  role        RoleName
  permission  String
  createdById String
  createdAt   DateTime @default(now())

  @@unique([tenantId, role, permission])
  @@index([tenantId, role])
}

/// 个别用户的额外授予/回收(优先级高于角色默认)
model UserPermission {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  permission  String
  /// false = 明确回收(即便角色默认有,也不给)
  granted     Boolean  @default(true)
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  @@unique([tenantId, userId, permission])
  @@index([tenantId, userId])
}

/// 物料属性定义(分类驱动的动态参数)。
/// 常用且需查询统计的字段留在结构化列;各品类差异化的参数走定义 + 值两张表。
model PartAttributeDefinition {
  id          String       @id @default(cuid())
  tenantId    String
  key         String
  label       String
  type        PartAttrType @default(TEXT)
  unit        String?
  required    Boolean      @default(false)
  /// 适用分类:留空=通用;否则按一级/二级分类匹配
  categoryL1  String?
  categoryL2  String?
  /// ENUM 类型的可选项
  options     Json?
  /// 校验规则(min/max/pattern 等)
  validation  Json?
  sortOrder   Int          @default(0)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  values PartAttributeValue[]

  @@unique([tenantId, key])
  @@index([tenantId, categoryL1, categoryL2, sortOrder])
}

model PartAttributeValue {
  id           String                  @id @default(cuid())
  tenantId     String
  partId       String
  part         Part                    @relation(fields: [partId], references: [id], onDelete: Cascade)
  definitionId String
  definition   PartAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  /// 原样保留用户/提取到的文本,数值化交给领域层(与 param-compare 同一套口径)
  value        String?
  /// 取值来源:MANUAL / EZPLM / AI_EXTRACT / ERP / IMPORT
  source       String                  @default("MANUAL")
  /// AI 提取置信度 0–1;人工录入为空
  confidence   Float?
  /// 人工是否已确认(AI 提取的默认 false,**不得直接当成已确认**)
  confirmed    Boolean                 @default(false)
  updatedById  String
  updatedAt    DateTime                @updatedAt
  createdAt    DateTime                @default(now())

  @@unique([tenantId, partId, definitionId])
  @@index([tenantId, definitionId])
}

/// 物料文档(规格书/承认书/RoHS/REACH/COC)。
/// 文件本体走 FileStorageProvider,**库里只存 key 与元数据**。
model PartDocument {
  id           String      @id @default(cuid())
  tenantId     String
  partId       String
  part         Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  kind         PartDocKind @default(OTHER)
  fileKey      String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  version      String?
  /// 有效期;为空即"未标注有效期",不等于长期有效
  validUntil   DateTime?
  /// 来源:UPLOAD / EZPLM / ERP / SUPPLIER
  source       String      @default("UPLOAD")
  note         String?
  uploadedById String
  createdAt    DateTime    @default(now())

  complianceEvidence PartComplianceEvidence[]

  @@index([tenantId, partId, kind])
  @@index([tenantId, validUntil])
}

/// 物料的默认供应商引用(**关联 Supplier 主数据,不写自由文本**)
model PartSupplierRef {
  id             String   @id @default(cuid())
  tenantId       String
  partId         String
  part           Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  /// 跨聚合引用:按 schema 顶部备案 B,supplierId 用**受控标量**而非 FK
  /// (租户隔离由应用层 tenant scope + 复合唯一约束保证)。
  /// 关键是"引用主数据 ID 而不是写自由文本",这一点已满足。
  supplierId     String
  supplierPn     String?
  /// 参考单价:**仅初始参考**,不是正式报价。正式价来自 DigiKey/Mouser/ezPLM/线下报价/历史采购价
  referencePrice Decimal? @db.Decimal(18, 6)
  currency       String   @default("CNY")
  isDefault      Boolean  @default(false)
  note           String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, partId, supplierId])
  @@index([tenantId, supplierId])
}

/// 建料过程留痕:重复检查结果、AI 提取证据、审核记录。
/// 一颗料一条,便于事后回答"当初凭什么建的、谁审的、AI 提了什么"。
model PartCreationRecord {
  id                  String               @id @default(cuid())
  tenantId            String
  partId              String               @unique
  part                Part                 @relation(fields: [partId], references: [id], onDelete: Cascade)
  /// 建料来源:MANUAL / EZPLM_REFERENCE / IMPORT / ERP_SYNC
  createdVia          String               @default("MANUAL")
  /// 重复检查命中的候选与用户处置
  duplicateCandidates Json?
  duplicateResolution DuplicateResolution?
  duplicateReason     String?
  /// AI 提取证据(字段 → {value, confidence, sourceFile})
  aiEvidence          Json?
  /// 审核记录
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNote          String?
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([tenantId, createdVia])
}

/// 物料标识(内部料号/MPN/客户料号等多标识索引)
model PartIdentifier {
  id        String   @id @default(cuid())
  tenantId  String
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  /// 标识类型:INTERNAL_PN / MPN / CUSTOMER_PN / OTHER(字符串保留扩展性)
  type      String
  value     String
  createdAt DateTime @default(now())

  @@unique([tenantId, type, value, partId])
  @@index([tenantId, value])
}

/// 客户料号映射(BOM 匹配顺序第 1 位)
model CustomerPartMapping {
  id           String    @id @default(cuid())
  tenantId     String
  customerId   String
  customerPn   String
  partId       String?
  mpn          String?
  manufacturer String?
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@unique([tenantId, customerId, customerPn])
  @@index([tenantId, partId])
}

/// 替代关系(ezPLM 同步 + 本地补充)
/// E2:三维兼容性(客户 Q10:「功能一致是最重要的」)。
/// 三者**正交、不可互推**:同封装可以引脚定义完全不同(SOT-23-5 是经典例子)。
enum FunctionalEquivalence {
  EXACT
  EQUIVALENT
  PARTIAL
  UNKNOWN
}

enum PackageCompatibility {
  EXACT
  MINOR_VARIATION
  DIFFERENT
  UNKNOWN
}

enum PinCompatibility {
  PIN_TO_PIN
  REQUIRES_REVIEW
  NOT_COMPATIBLE
  UNKNOWN
}

model PartAlternate {
  id              String   @id @default(cuid())
  tenantId        String
  partId          String
  part            Part     @relation("PartToAlternates", fields: [partId], references: [id])
  alternatePartId String
  alternatePart   Part     @relation("AlternateToParts", fields: [alternatePartId], references: [id])
  /// 替代等级/说明(如 完全替代/条件替代)。保留:历史数据都挂在它上面
  grade           String?
  /// E2 三维兼容性。默认 UNKNOWN —— **旧数据没核过就是没核过**,
  /// 迁移时不替它猜一个"看起来合理"的值。
  functionalEquivalence FunctionalEquivalence @default(UNKNOWN)
  packageCompatibility  PackageCompatibility  @default(UNKNOWN)
  pinCompatibility      PinCompatibility      @default(UNKNOWN)
  /// 判定依据(datasheet 章节、对比结论等)—— 没有依据的兼容级别不可信
  reason          String?
  /// 依据来源:EZPLM / DIGIKEY / MOUSER / WEB / MANUAL
  evidenceSource  String?
  /// 谁拍的板。工程确认过的替代关系才敢直接用
  approvedById    String?
  approvedAt      DateTime?
  note            String?
  createdAt       DateTime @default(now())
  /// **必须带默认值**:PartAlternate 在生产库里已经有数据,
  /// 加一个没有默认值的 NOT NULL 列会让迁移直接失败(项目的迁移安全守卫会拦)。
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([tenantId, partId, alternatePartId])
  @@index([tenantId, functionalEquivalence])
}

/// 库存快照(来源 ezPLM,只读缓存;呆滞数量为候选展示项)
model InventorySnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  partId        String
  qtyOnHand     Decimal  @db.Decimal(18, 4)
  /// 呆滞数量
  qtySlowMoving Decimal? @db.Decimal(18, 4)
  warehouse     String?
  fetchedAt     DateTime

  @@index([tenantId, partId, fetchedAt])
}

/// 在途 PO 行(GTB 扣减项;来源 ezPLM/ERP,只读缓存)
model OpenPOLine {
  id         String    @id @default(cuid())
  tenantId   String
  partId     String
  poNo       String
  qtyOpen    Decimal   @db.Decimal(18, 4)
  eta        DateTime?
  supplierId String?
  fetchedAt  DateTime

  @@index([tenantId, partId])
}

/// BOM 匹配候选(SPEC §6:候选必须显示的字段全部落列;AI 只写候选,不写决定)
model BomMatchCandidate {
  id            String      @id @default(cuid())
  tenantId      String
  bomLineId     String
  bomLine       BOMLine     @relation(fields: [bomLineId], references: [id])
  source        MatchSource
  /// 置信度 0–1
  confidence    Decimal     @db.Decimal(5, 4)
  partId        String?
  mpn           String
  manufacturer  String?
  footprint     String?
  lifecycle     Lifecycle?
  stockQty      Decimal?    @db.Decimal(18, 4)
  slowMovingQty Decimal?    @db.Decimal(18, 4)
  opoQty        Decimal?    @db.Decimal(18, 4)
  eta           DateTime?
  price         Decimal?    @db.Decimal(18, 6)
  currency      String?
  /// 替代关系摘要
  alternates    Json?
  /// 数据更新时间(诚实 UI:显示更新时间而非暗示实时)
  dataUpdatedAt DateTime?
  /// 判断依据(相似度候选写明为什么排在这里),供人工确认时参考
  matchReason   String?
  createdAt     DateTime    @default(now())

  @@index([tenantId, bomLineId])
}

/// BOM 行人工确认(正式匹配必须人工;每行至多一个生效决定,由 @@unique([tenantId, bomLineId]) 保证)
model BomLineDecision {
  id          String           @id @default(cuid())
  tenantId    String
  bomLineId   String
  bomLine     BOMLine          @relation(fields: [bomLineId], references: [id])
  /// 受控标量(评审必改 A 备案):候选可被重算清理,而人工决定必须长寿,故不设 FK
  candidateId String?
  partId      String?
  decision    LineDecisionType
  note        String?
  decidedById String
  decidedAt   DateTime         @default(now())

  @@unique([tenantId, bomLineId])
}

/// 替代料候选清单:人工在「替代料查询」里勾选下来的候选。
///
/// 语义上是**待工程确认的候选清单**,不是已成立的替代关系 ——
/// 正式替代关系走 PartAlternate / AVL 规则,需另行审批。
/// 存评分快照是为了事后能看到"当时是凭什么勾的",评分算法改了也不影响追溯。
model AlternateSelection {
  id           String   @id @default(cuid())
  tenantId     String
  /// 被替代件 MPN(不建 FK:该料未必在本地物料库里)
  mpn          String
  /// 勾选的候选型号
  alternateMpn String
  manufacturer String?
  /// 勾选时用的替代模式
  mode         String
  /// 勾选时的四维评分快照
  technical    Int
  evidence     Int
  sourceTrust  Int
  confidence   Int
  /// 判断依据与警示的快照
  reasons      Json?
  warnings     Json?
  /// 勾选时的市场行情快照(价格/供货,非实时)
  market       Json?
  note         String?
  selectedById String
  selectedAt   DateTime @default(now())

  @@unique([tenantId, mpn, alternateMpn])
  @@index([tenantId, mpn])
}

/// 外部 API 响应缓存快照。
/// cacheKey = provider+site+currency+mpn+manufacturer+quantity(SPEC §15)。
/// expiresAt 派生自 fetchedAt + ttlSeconds,由写入通道统一计算(唯一写入点),仅为索引效率物化。
model ExternalPartSnapshot {
  id         String       @id @default(cuid())
  tenantId   String
  source     ProviderType
  cacheKey   String
  payload    Json
  fetchedAt  DateTime
  ttlSeconds Int
  expiresAt  DateTime
  createdAt  DateTime     @default(now())

  @@unique([tenantId, source, cacheKey])
  @@index([tenantId, expiresAt])
}

// ============================================================
// 5. 报价供应域(NormalizedOffer 持久化)
// ============================================================

/// 统一供应报价(SPEC §10 NormalizedOffer;线下 Excel 与三源 API 同构)
model SupplierOffer {
  id                 String       @id @default(cuid())
  tenantId           String
  provider           ProviderType
  supplierId         String?
  partId             String?
  providerPartNumber String?
  mpn                String
  manufacturer       String?
  description        String?
  packaging          String?
  stock              Decimal?     @db.Decimal(18, 4)
  moq                Decimal?     @db.Decimal(18, 4)
  spq                Decimal?     @db.Decimal(18, 4)
  leadTimeDays       Int?
  lifecycle          Lifecycle?
  rohs               Boolean?
  reach              Boolean?
  currency           String
  sourceUpdatedAt    DateTime?
  sourceUrl          String?
  createdAt          DateTime     @default(now())

  priceBreaks PriceBreak[]

  @@index([tenantId, mpn])
  @@index([tenantId, provider, mpn])
}

/// 价格阶梯(确定性函数 getApplicablePriceBreak 的输入)
model PriceBreak {
  id              String        @id @default(cuid())
  tenantId        String
  supplierOfferId String
  supplierOffer   SupplierOffer @relation(fields: [supplierOfferId], references: [id])
  minQty          Decimal       @db.Decimal(18, 4)
  unitPrice       Decimal       @db.Decimal(18, 6)

  @@unique([tenantId, supplierOfferId, minQty])
}

// ============================================================
// 6. 报价域(Quote,本系统唯一真源)
// ============================================================

/// 报价单标识。状态/参数在 QuoteVersion 上(每个修订各有生命周期,避免冗余镜像);
/// 当前版 = revision 最大的 QuoteVersion,查询派生,不落冗余字段。
/// 报价的**订单结果**(客户 Q7 答复:人工在报价单上标记「已中标」)。
/// 与审批状态(QuoteStatus)是两回事:审批通过只说明我们报出去了,
/// 中标与否要等客户下单 —— 原先把「审批通过率」当「订单转化率」是口径错误。
enum QuoteOutcome {
  OPEN
  WON
  LOST
  EXPIRED
}

model Quote {
  id              String       @id @default(cuid())
  tenantId        String
  code            String
  rfqId           String
  customerId      String
  /// 订单结果;**只能人工标记**,系统不从任何地方推断
  outcome         QuoteOutcome @default(OPEN)
  outcomeAt       DateTime?
  outcomeById     String?
  /// 中标时的客户订单号(可空:客户不一定当场给得出)
  customerOrderNo String?
  /// 标记原因/备注 —— 改判(WON→LOST)时强制填写
  outcomeNote     String?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  versions QuoteVersion[]
  tasks    QuoteComponentTask[]

  @@unique([tenantId, code])
  @@index([tenantId, rfqId])
  @@index([tenantId, outcome])
}

/// 报价修订版。
/// 快照选型:Json 字段(submittedSnapshot/approvedSnapshot)而非再归一化表 ——
/// 快照是"冻结文档"(整单含行/费率/汇总),用于审批与正式 PDF/XLSX 的唯一依据;
/// Json 整体固化保证逐字节不漂移,不受后续行结构迁移影响;可编辑数据仍在 QuoteLine。
/// Revision 递增由 @@unique([tenantId, quoteId, revision]) 保证;
/// "禁止覆盖已批准版本"= 应用层只允许 INSERT 新修订,PENDING/APPROVED 版参数冻结(单测覆盖)。
model QuoteVersion {
  id                String      @id @default(cuid())
  tenantId          String
  quoteId           String
  quote             Quote       @relation(fields: [quoteId], references: [id])
  revision          Int
  status            QuoteStatus @default(DRAFT)
  /// 报价有效期(正式报价单必备项;提交时随快照冻结)
  validUntil        DateTime?
  currency          String      @default("CNY")
  /// 人工费率模板快照(多模板可选,允许手工调整;模板本体后续 PR 建维护页)
  laborRateTemplate Json?
  /// 提交审批时冻结的整单快照
  submittedSnapshot Json?
  /// 审批通过时冻结的整单快照(PDF/XLSX 唯一数据源)
  approvedSnapshot  Json?
  submittedAt       DateTime?
  approvedAt        DateTime?
  /// 退回原因(退回后创建新 Revision)
  rejectedReason    String?
  expiresAt         DateTime?
  createdById       String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lines     QuoteLine[]
  approvals QuoteApproval[]

  @@unique([tenantId, quoteId, revision])
  @@index([tenantId, status])
}

/// 报价行(SPEC §12 全部字段;金额 Decimal,币种随版本)
model QuoteLine {
  id                    String            @id @default(cuid())
  tenantId              String
  quoteVersionId        String
  quoteVersion          QuoteVersion      @relation(fields: [quoteVersionId], references: [id])
  lineNo                Int
  category              QuoteCostCategory
  bomLineId             String?
  /// 报价 MFG / MPN
  quotedMfg             String?
  quotedMpn             String?
  /// 物料类别(阻容/IC/结构件等,Markup 分档依据)
  materialCategory      String?
  /// 物料类别是否经**人工**确认(CLAUDE.md:分类未全部人工确认不得提交审批)。
  /// 必须与 materialCategory 分开:AI 也能填分类,"有分类"不等于"人工确认过"。
  categoryConfirmed     Boolean           @default(false)
  categoryConfirmedById String?
  categoryConfirmedAt   DateTime?
  /// 替代料 MFG / MPN
  altMfg                String?
  altMpn                String?
  qty                   Decimal?          @db.Decimal(18, 4)
  /// 采购成本(单价)
  purchaseCost          Decimal?          @db.Decimal(18, 6)
  /// Markup 百分比(如 0.085 = 8.5%)
  markupPct             Decimal?          @db.Decimal(9, 6)
  /// 最终物料报价(单价,确定性函数计算)
  finalUnitPrice        Decimal?          @db.Decimal(18, 6)
  /// 实际客户报价价格(单价,人工可调)
  customerPrice         Decimal?          @db.Decimal(18, 6)
  /// PPV(确定性函数计算)
  ppv                   Decimal?          @db.Decimal(18, 6)
  note                  String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([tenantId, quoteVersionId, lineNo])
}

/// 审批记录。审批人必须是五角色模型内的 User(应用层校验 + 单测)
model QuoteApproval {
  id             String           @id @default(cuid())
  tenantId       String
  quoteVersionId String
  quoteVersion   QuoteVersion     @relation(fields: [quoteVersionId], references: [id])
  approverId     String
  decision       ApprovalDecision @default(PENDING)
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([tenantId, quoteVersionId])
}

// ============================================================
// 7. 采购 RFQ 域
// ============================================================

/// 采购 RFQ(SPEC §11):接收 PM 的一个或多个 BOM(经 rfqId 关联),多源比价
model ProcurementRFQ {
  id            String               @id @default(cuid())
  tenantId      String
  code          String
  rfqId         String?
  /// 关联的 BOMVersion id 列表(一个或多个 BOM)。
  /// 已知取舍(评审备案 D):Json 数组保持 43 模型基线;反向查询("按 BOM 版本反查采购 RFQ")
  /// 依赖 jsonb 包含查询;若该查询高频化,再升级为关联表。
  bomVersionIds Json?
  status        ProcurementRfqStatus @default(DRAFT)
  sourcingMode  SourcingMode         @default(SPOT)
  /// 反馈给 PM 的说明
  feedbackNote  String?
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  supplierQuotes SupplierQuote[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

/// 供应商报价单(线下 Excel 导入或 API 拉取的一次报价)
model SupplierQuote {
  id               String         @id @default(cuid())
  tenantId         String
  procurementRfqId String
  procurementRfq   ProcurementRFQ @relation(fields: [procurementRfqId], references: [id])
  supplierId       String
  provider         ProviderType   @default(OFFLINE)
  currency         String
  /// 原始导入文件(线下 Excel)
  sourceFileKey    String?
  quotedAt         DateTime
  createdAt        DateTime       @default(now())

  lines SupplierQuoteLine[]

  @@index([tenantId, procurementRfqId])
}

/// 供应商报价行。
/// 异常处理闭环(CLAUDE.md):wasFlagged 在采购填价时固化"原始异常集合";
/// resolution 默认空、逐项人工选;换货源(SWITCH_SOURCE)必须新建行记录
/// 新供应商/价格/币种/MOQ/SPQ/LT/报价时间,previousLineId 链回旧行,旧行不改写。
model SupplierQuoteLine {
  id              String          @id @default(cuid())
  tenantId        String
  supplierQuoteId String
  supplierQuote   SupplierQuote   @relation(fields: [supplierQuoteId], references: [id])
  bomLineId       String?
  partId          String?
  mpn             String
  manufacturer    String?
  unitPrice       Decimal         @db.Decimal(18, 6)
  currency        String
  moq             Decimal?        @db.Decimal(18, 4)
  spq             Decimal?        @db.Decimal(18, 4)
  leadTimeDays    Int?
  sourcingMode    SourcingMode    @default(SPOT)
  quotedAt        DateTime
  /// 原始异常集合固化(填价时一次性写入,此后不随阈值变化)
  wasFlagged      Boolean         @default(false)
  /// 异常原因明细(如 超价格线/超 LT 线)
  flagReasons     Json?
  /// 异常处理结论(默认空,人工逐项选择)
  resolution      FlagResolution?
  resolutionNote  String?
  /// 换货源/重报价链:指向被替代的旧行
  previousLineId  String?
  /// 采购选定标记与选择理由(SPEC §11)
  selected        Boolean         @default(false)
  selectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId, supplierQuoteId])
  @@index([tenantId, bomLineId])
}

/// 采购策略阈值(Backlog B3)。
/// ⚠ SPEC §4 的 43 模型之外的增量:异常判定阈值原先是页面内常量,
/// 需按租户持久化才能作为正式风控依据;阈值口径本身仍待业务确认。
model ProcurementPolicy {
  id                  String   @id @default(cuid())
  tenantId            String
  /// 比价基准币种(异币种报价即为异常)
  currency            String   @default("CNY")
  /// 价格线:单价高于此值判为异常;null = 不校验
  maxUnitPrice        Decimal? @db.Decimal(18, 6)
  /// 交期线:天数高于此值判为异常;null = 不校验
  maxLeadTimeDays     Int?
  /// 口径是否经业务确认;未确认时 UI 必须标注"演示阈值,非正式风控"
  confirmedByBusiness Boolean  @default(false)
  updatedById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  /// 每租户一条生效策略
  @@unique([tenantId])
}

/// PM 端采购申请单(整合方案 3.2;GTB 核算 + 同 MPN 呆滞提示)
model PurchaseRequest {
  id            String                @id @default(cuid())
  tenantId      String
  code          String
  requestedById String
  bomVersionId  String?
  partId        String?
  mpn           String?
  /// 申请数量(GTB 确定性函数输出;核算过程存快照)
  qty           Decimal               @db.Decimal(18, 4)
  /// GTB 核算快照(需求/损耗率/库存/Excess/在途/MOQ/SPQ 圆整过程)
  gtbSnapshot   Json?
  status        PurchaseRequestStatus @default(DRAFT)
  note          String?

  /**
   * PR2-PROC-05:客户点名要在申请单行上看到的字段。
   * 全部**可空**:数据源缺失时页面显示「未知/未接入」,不回落成 0 或空串 ——
   * 采购申请是下单依据,一个凭空的 0 会直接变成买错量。
   */
  /// 内部料号 / 制造商 —— 与 mpn 一起构成"买的到底是哪颗料"
  internalPn        String?
  manufacturer      String?
  /// 需求量与需求日期(区别于经 GTB 圆整后的 qty)
  demandQty         Decimal?  @db.Decimal(18, 4)
  requiredDate      DateTime?
  /// 归属客户与项目 —— 跨客户占用 Excess 是业务事故,必须能分辨
  customerId        String?
  projectCode       String?
  /// 核算当时的快照量(**冻结值**,不随库存变动改写,否则事后无法复核)
  internalInventory Decimal?  @db.Decimal(18, 4)
  excessQty         Decimal?  @db.Decimal(18, 4)
  openPoQty         Decimal?  @db.Decimal(18, 4)
  eta               DateTime?
  /// 选定供应商与最终采购决策(由采购在比价后回填)
  supplierId        String?
  selectedBuyQty    Decimal?  @db.Decimal(18, 4)
  approvedUnitPrice Decimal?  @db.Decimal(18, 6)
  currency          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, mpn])
}

/// 采购订单(客户 xlsx「采购订单全流程创建、审批、跟踪」)。
///
/// 位置:PurchaseRequest(PM 申请)→ ProcurementRFQ(比价选型)→ **PurchaseOrder** → OPOLine(在途)。
/// 数据主权:本系统是**采购订单流程**的唯一真源;ERP 是**下单执行**的真源。
/// 因此本表不记"是否已在 ERP 下单成功",只记本系统产出的 ERP 模板导出事实,
/// 并在审批通过后**一次性**生成 OPOLine 交给在途协同(禁止双写)。
model PurchaseOrder {
  id                  String              @id @default(cuid())
  tenantId            String
  /// 单号(租户内唯一);与 OPOLine.poNo 对齐,便于在途协同回查
  poNo                String
  supplierId          String
  /// 比价币种口径;行级币种与之不同即为异常(系统不做汇率换算)
  currency            String              @default("CNY")
  status              PurchaseOrderStatus @default(DRAFT)
  /// 来源(可空:也允许采购直接建单)
  procurementRfqId    String?
  purchaseRequestId   String?
  createdById         String
  /// 退回原因(最近一次);历史留在 PurchaseOrderApproval
  rejectReason        String?
  /// 作废原因
  cancelReason        String?
  /// 被哪张单取代(已批准单要改只能作废后新建,规则 5)
  supersededById      String?
  /// 提交复核时固化的复核快照(行项 + 判定依据),审批与导出只用快照
  reviewSnapshot      Json?
  /// 终审通过时固化的快照
  approvedSnapshot    Json?
  /// 已导出 ERP 模板的时间(**不代表 ERP 已接单**)
  erpExportedAt       DateTime?
  /// 导出后登记的集成作业引用
  erpIntegrationJobId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  lines     PurchaseOrderLine[]
  approvals PurchaseOrderApproval[]

  @@unique([tenantId, poNo])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
}

/// 采购订单行。行级是唯一数据源 —— 台账 KPI、异常清单全部由本表派生,
/// 不落任何冗余计数字段(与 OPO 同一条纪律)。
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNo          Int
  partId          String?
  mpn             String?
  manufacturer    String?
  description     String?
  /// 采购数量(经 MOQ 下限 + SPQ 向上圆整)
  qty             Decimal       @db.Decimal(18, 4)
  unitPrice       Decimal?      @db.Decimal(18, 6)
  /// 行币种;与单头 currency 不一致时判异常
  currency        String        @default("CNY")
  moq             Int?
  spq             Int?
  leadTimeDays    Int?
  /// 需求日期(反推下单日的输入)
  requestDate     DateTime?
  /// 建议下单日 = 需求日 − 交期;交期未知时为空(不猜)
  orderByDate     DateTime?
  sourcingMode    SourcingMode  @default(FUTURES)
  /// 复核时固化的**原始异常集合**(与比价页 wasFlagged 同一条纪律:
  /// 此后不随阈值变化而增减)
  wasFlagged      Boolean       @default(false)
  flagReasons     Json?
  /// 历史价对比快照(参照单据、变化率、判定);无可比时也要存,存的是"为何不可比"
  historySnapshot Json?
  /// 异常处理结论(默认空,逐项人工选)
  resolution      String?
  resolutionNote  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([tenantId, purchaseOrderId, lineNo])
  @@index([tenantId, mpn])
}

/// PO 审批记录(价格复核 + 终审两道关,各自留痕)
model PurchaseOrderApproval {
  id              String           @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stage           PoApprovalStage
  approverId      String
  decision        ApprovalDecision @default(PENDING)
  comment         String?
  decidedAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([tenantId, purchaseOrderId])
}

/// AR/AP 对账单(客户 xlsx「应收应付自动对账」;差异识别与账龄原标注为「无」)。
///
/// 数据主权:本系统**没有出货/入库/发票模型** —— 那是 ERP 的范围。
/// 因此"我方基准"只能来自 ①本系统已批准单据派生(AP=PO 行,AR=报价快照)
/// 或 ②ERP 导出明细上传,由 baselineSource 如实记录是哪一种。
model ReconciliationStatement {
  id              String               @id @default(cuid())
  tenantId        String
  kind            ReconciliationKind
  code            String
  /// AR 用 customerId;AP 用 supplierId(跨聚合引用,受控标量)
  customerId      String?
  supplierId      String?
  currency        String               @default("CNY")
  periodFrom      DateTime?
  periodTo        DateTime?
  status          ReconciliationStatus @default(DRAFT)
  baselineSource  ReconBaselineSource  @default(DERIVED)
  /// 金额容差(口径,不是魔法数;UI 必须标注)
  amountTolerance Decimal              @default("0.01") @db.Decimal(18, 6)
  /// 匹配时固化的汇总快照(双方合计/差额/各类计数)
  matchSnapshot   Json?
  matchedAt       DateTime?
  /// 对账单发送记录:**只到预览/模拟**,不代表已发送
  lastPreviewAt   DateTime?
  /// E5:示例数据。客户说「不知如何实现,需要举例」,所以提供一键加载的样例;
  /// **必须与正式数据区分**,否则演示用的数字会混进对账结论里。
  /// 台账上打标、KPI 里排除、可一键清除。
  isExample       Boolean              @default(false)
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  lines ReconciliationLine[]

  @@unique([tenantId, code])
  @@index([tenantId, kind, status])
}

/// 对账行:双方明细并列 + 判定。台账与账龄全部由本表派生,不落冗余计数。
model ReconciliationLine {
  id             String                  @id @default(cuid())
  tenantId       String
  statementId    String
  statement      ReconciliationStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  lineNo         Int
  /// 匹配键(便于人工回查为何这两行被配到一起)
  matchKey       String
  docNo          String?
  docLineNo      Int?
  mpn            String?
  theirQty       Decimal?                @db.Decimal(18, 4)
  theirUnitPrice Decimal?                @db.Decimal(18, 6)
  theirAmount    Decimal?                @db.Decimal(18, 4)
  theirCurrency  String?
  ourQty         Decimal?                @db.Decimal(18, 4)
  ourUnitPrice   Decimal?                @db.Decimal(18, 6)
  ourAmount      Decimal?                @db.Decimal(18, 4)
  ourCurrency    String?
  verdict        ReconLineVerdict
  /// 对方 − 我方(同币种);不可比时为空
  diffAmount     Decimal?                @db.Decimal(18, 4)
  severity       String
  details        Json?
  /// 账龄输入;识别不出时留空,由账龄模块归入「到期日未知」
  dueDate        DateTime?
  /// 差异处理结论(默认空,逐项人工选)
  resolution     String?
  resolutionNote String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([tenantId, statementId, lineNo])
  @@index([tenantId, verdict])
}

/// 批量 update 报价作业(客户 xlsx 新增需求:「批量导入 BOM,生成单个单个 BOM 列明的 update 的报价单」)。
///
/// 语义是 **update**:已有报价的 BOM 走**新建 Revision**(遵守"已批准版本禁止覆盖"),
/// 没有报价的 BOM 才新建报价。逐 BOM 独立成败,一条失败不拖垮整批。
model QuoteBatchUpdateJob {
  id            String    @id @default(cuid())
  tenantId      String
  status        JobStatus @default(PENDING)
  totalBoms     Int       @default(0)
  processedBoms Int       @default(0)
  /// 逐 BOM 结果明细(成功/失败与原因),便于人工回查
  results       Json?
  error         String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
}

/// 损耗记录(客户 xlsx:「损耗报告 —— 筛选条件进行损耗分析 / 依据客户模板导出损耗」,原标注均为「无」)。
///
/// 数据主权:真正的投料/报废数据在 MES/ERP,本系统没有工单投料。
/// 一期做「导入 + 分析 + 按模板导出」,来源如实记为 IMPORTED,不假装是系统自己算出来的。
/// Excess(呆滞/多余料)来源。PR2-PROC-05-D。
/// **没有 NONE 之外的默认** —— 未配置时系统显示「数据源未配置」,绝不编数。
enum ExcessSource {
  EXCEL_IMPORT
  ERP
  MANUAL
}

/// Excess 快照:一次导入/同步 = 一个快照。
/// 快照式而非可变表 —— 「上个月说有 500 可用」必须能复现,
/// 否则事后无法解释当时为什么少买了。
model ExcessSnapshot {
  tenantId    String
  id          String       @id @default(cuid())
  source      ExcessSource
  /// 快照对应的业务时点(不是导入时刻)
  snapshotAt  DateTime
  /// 来自导入作业时关联;ERP 同步或人工录入为空
  importJobId String?
  /*
   * E8:来源可追溯(客户 Q1:「ERP 有 Excess report 可以引用」)。
   * PM 在采购申请里看到的 Excess 必须能回答"这数出自哪一次、什么时候的 ERP 报表" ——
   * 否则少买了料谁也说不清依据。
   */
  /// ERP 侧的报表/单据号
  sourceDocumentId String?
  /// ERP 侧该数据的更新时间(**不是**我们导入的时间)
  sourceUpdatedAt  DateTime?
  /// 我们导入/同步的时间
  importedAt       DateTime?
  /// ERP 连接 id(经 API 同步时)
  erpConnectionId  String?
  note        String?
  createdById String
  createdAt   DateTime     @default(now())

  lines ExcessLine[]

  @@index([tenantId, snapshotAt])
}

/// Excess 明细行。
///
/// customerId 可空 = 通用库存;非空 = **客供料或专属该客户**。
/// 跨客户占用是业务事故,所以系统只提示可用量,占用与否由 PM 人工确认
/// (见 lib/domain/gtb.ts:excessQty 的说明)。
model ExcessLine {
  tenantId     String
  id           String         @id @default(cuid())
  snapshotId   String
  snapshot     ExcessSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  /// 归属客户;为空表示不限客户
  customerId   String?
  partId       String?
  internalPn   String?
  mpn          String?
  /// 账面数量
  qty          Decimal        @db.Decimal(18, 4)
  /// 其中**可动用**的数量(可能小于账面:部分已被锁定/待报废)
  availableQty Decimal        @db.Decimal(18, 4)
  notes        String?

  @@index([tenantId, mpn])
  @@index([tenantId, customerId])
}

/// 缺料单来源。PR2-PROC-10。
enum ShortageSheetSource {
  EXCEL_IMPORT
  ERP
  MANUAL
}

/// 缺料行状态机。客户明确要求「已经处理过的显示处理过」。
///
/// 只允许单向推进:OPEN → CALL_CREATED → SENT_TO_SUPPLIER → PARTIALLY_RESOLVED → RESOLVED。
/// **不设回退** —— 缺料处理是对外承诺过的动作,悄悄退回上一状态
/// 会让"已经催过供应商"这件事凭空消失。
enum ShortageLineStatus {
  OPEN
  CALL_CREATED
  SENT_TO_SUPPLIER
  PARTIALLY_RESOLVED
  RESOLVED
}

/// 缺料分析单。
///
/// PR2-PROC-10(客户原话:「缺料分析是根据**缺料分析单**来的,而非 BOM」)。
/// 与 /shortage 既有的「按 BOM × 台数推算」是两回事:那是**核算工具**,
/// 这是**业务单据** —— 有来源、有状态、有责任人、能被追踪到闭环。
model ShortageSheet {
  tenantId    String
  id          String              @id @default(cuid())
  code        String
  source      ShortageSheetSource
  /// 单据对应的业务时点(不是导入时刻)
  sheetDate   DateTime
  customerId  String?
  note        String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  lines ShortageSheetLine[]

  @@unique([tenantId, code])
  @@index([tenantId, sheetDate])
}

/// 缺料行。
///
/// 客户点名**不要位号**(「位号不需要因为多行」)、**不要「建议采购」**
/// (那是 GTB 的事;缺料单给的是单据认定的实际缺口)。
model ShortageSheetLine {
  tenantId           String
  id                 String             @id @default(cuid())
  sheetId            String
  sheet              ShortageSheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  customerId         String?
  internalPn         String?
  manufacturer       String?
  mpn                String?
  requiredQty        Decimal            @db.Decimal(18, 4)
  /// 下面三项是**导入时点的快照**,不随库存变动改写 ——
  /// 否则事后无法解释"当时为什么判定缺这么多"
  availableInventory Decimal?           @db.Decimal(18, 4)
  openPoQty          Decimal?           @db.Decimal(18, 4)
  eta                DateTime?
  supplierId         String?
  /// 缺口数量:**由单据给定,不由系统推算** —— 单据才是真源
  shortageQty        Decimal            @db.Decimal(18, 4)
  /// 采购决定要 call 的数量;未填为 null(**不是 0**)
  callQty            Decimal?           @db.Decimal(18, 4)
  requiredDate       DateTime?
  status             ShortageLineStatus @default(OPEN)
  note               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  callRecords CallMaterialRecord[]

  @@index([tenantId, status])
  @@index([tenantId, mpn])
}

/// Call 料记录:采购填了 Call Qty 之后产生的**对外动作**。
///
/// 邮件通道未接通时 emailState 停在 DRAFT —— 界面只能显示
/// 「待发送 / 邮件草稿已生成」,**绝不能显示「已发送」**(CLAUDE.md 诚实 UI)。
model CallMaterialRecord {
  tenantId          String
  id                String            @id @default(cuid())
  lineId            String
  line              ShortageSheetLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  supplierId        String?
  callQty           Decimal           @db.Decimal(18, 4)
  /// DRAFT(草稿已生成)/ QUEUED / SENT / FAILED。
  /// **没有 SMTP 时只会是 DRAFT**,不会凭空变 SENT。
  emailState        String            @default("DRAFT")
  emailSubject      String?
  emailBody         String?
  toEmails          String[]
  /// 真实发信后才有值;未发送时全为空
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdById       String
  createdAt         DateTime          @default(now())

  @@index([tenantId, lineId])
}

model ScrapRecord {
  id          String   @id @default(cuid())
  tenantId    String
  /// 期间标签(如 2026-07),用于按期筛选
  period      String
  customerId  String?
  workOrder   String?
  mpn         String?
  /// 发料数量(损耗率分母)
  issuedQty   Decimal  @db.Decimal(18, 4)
  /// 报废/损耗数量
  scrapQty    Decimal  @db.Decimal(18, 4)
  reason      String?
  note        String?
  /// 数据来源:一期只有 IMPORTED(人工导入);待 MES 接通后再扩
  source      String   @default("IMPORTED")
  createdById String
  createdAt   DateTime @default(now())

  @@index([tenantId, period])
  @@index([tenantId, mpn])
}

/// 客户损耗导出模板(客户要求「依据客户模版导出损耗」)。
/// 模板只定义**列集合与表头别名**,不改变数值口径。
model ScrapExportTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  customerId  String?
  /// [{ field, header }] 有序列定义
  columns     Json
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
}

/// 报价模板(客户 xlsx:「A/B/C 类客户差异化报价规则配置,多套报价模板预设」)。
///
/// 纪律:
/// - **默认 Markup 初始为空**,不预设任何百分比 —— 未经甲方确认的数字一旦写进代码,
///   就会被当成"系统给的标准";
/// - confirmedByBusiness=false 时 UI 必须标「口径待确认」;
/// - 模板只提供**默认值**,报价行仍可人工覆盖,且金额一律由确定性函数计算。
model QuoteTemplate {
  id                  String        @id @default(cuid())
  tenantId            String
  name                String
  /// 适用客户等级;为空表示通用模板
  tier                CustomerTier?
  /// 默认 Markup(小数,如 0.15 = 15%);**初始为空,须人工维护**
  defaultMarkupPct    Decimal?      @db.Decimal(10, 6)
  /// 人工费率模板 id(对应 BUILTIN_LABOR_TEMPLATES)
  laborTemplateId     String?
  /// 口径是否经业务确认;false 时 UI 标注"待确认,非正式定价规则"
  confirmedByBusiness Boolean       @default(false)
  note                String?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, tier])
}

/// ERP 连接(每租户可配多个)。
///
/// 纪律:
/// - **凭据不存在本表**,单独放 ErpCredential 并加密;本表只存非敏感配置;
/// - status=CONNECTED **只能**由真实 testConnection 成功后写入;
/// - 未配置凭据一律 NOT_CONFIGURED,UI 显示「待联调」,不显示"连接正常"。
model ErpConnection {
  id                  String              @id @default(cuid())
  tenantId            String
  name                String
  vendor              ErpVendor
  /// 厂商下的具体版本:K3 / 云星空 / 星瀚 / U8 / NC / YonBIP / B1 / S4HANA / NetSuite / EBS
  edition             String?
  /// 非敏感配置(base url / 账套 / 组织编码 / locale / 超时等)
  config              Json
  status              ErpConnectionStatus @default(NOT_CONFIGURED)
  /// 最近一次真实连接测试的结果(响应时间/版本/组织/可用能力/失败原因/建议)
  lastTestAt          DateTime?
  lastTestResult      Json?
  /// 同步频率(cron 表达式;空=仅手工)
  syncCron            String?
  enabled             Boolean             @default(true)
  /// ---- 连接健康(PR-D)----
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  /// 连续失败次数;成功即清零。用于 Healthy / Warning / Offline 判定
  consecutiveFailures Int                 @default(0)
  lastError           String?
  /// Token 到期时间(可得时);用于提前预警而不是等它失效
  tokenExpiresAt      DateTime?
  createdById         String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  credentials ErpCredential[]
  mappings    ErpFieldMapping[]
  policies    ErpSyncPolicy[]
  jobs        ErpSyncJob[]

  @@unique([tenantId, name])
  @@index([tenantId, vendor, status])
}

/// ERP 凭据(AppSecret / Token / 密码)。
///
/// **密文入库**(AES-256-GCM),API 只回掩码,AuditLog 与日志只记字段名不记值。
/// 缺少加密密钥时**拒绝保存**,不降级成明文 —— 明文存凭据比不存更糟。
model ErpCredential {
  id           String        @id @default(cuid())
  tenantId     String
  connectionId String
  connection   ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// 字段名,如 appSecret / password / token
  field        String
  /// 密文(base64);**任何接口都不得回传本字段**
  cipherText   String
  iv           String
  authTag      String
  /// 掩码预览,如 ****1a2b(只留末 4 位,便于人核对是不是同一把钥匙)
  maskedHint   String
  /// ---- 密钥轮换(PR-D)----
  /// 加密所用密钥的版本号。轮换时新写入用新版本,旧密文仍可用旧版本解开
  keyVersion   Int           @default(1)
  /// 最近一次"用这份凭据真的调通了外部系统"的时间 —— 与"保存过"不是一回事
  verifiedAt   DateTime?
  /// 凭据本身的到期时间(如 Token);到期前预警
  expiresAt    DateTime?
  updatedById  String
  updatedAt    DateTime      @updatedAt
  createdAt    DateTime      @default(now())

  @@unique([tenantId, connectionId, field])
}

/// 字段映射(ERP 字段 ↔ 本系统字段)
model ErpFieldMapping {
  id           String        @id @default(cuid())
  tenantId     String
  connectionId String
  connection   ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType   ErpEntityType
  /// ERP 侧字段名
  erpField     String
  /// 本系统字段名
  localField   String
  /// 转换函数名(如 trim / upper / decimal / date:YYYYMMDD);空=原样
  transform    String?
  defaultValue String?
  required     Boolean       @default(false)
  /// 保存映射时做的样例验证结果(样例值 → 转换后值 / 失败原因)
  sampleResult Json?
  sortOrder    Int           @default(0)
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, connectionId, entityType, localField])
  @@index([tenantId, connectionId, entityType])
}

/// 同步策略(按实体配置方向、冲突处理、增量口径)
model ErpSyncPolicy {
  id                    String            @id @default(cuid())
  tenantId              String
  connectionId          String
  connection            ErpConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType            ErpEntityType
  direction             ErpSyncDirection  @default(IMPORT_ONLY)
  conflictPolicy        ErpConflictPolicy @default(QUEUE_FOR_HUMAN)
  /// 增量游标字段与上次水位(空=全量)
  incrementalField      String?
  /// 最近一次**尝试**留下的游标(可能来自失败的那次)
  lastCursor            String?
  /// ---- 成功水位(PR-D)----
  /// 只有整批成功才推进。恢复同步以它为准,避免用失败游标跳过数据
  lastSuccessfulCursor  String?
  lastSuccessfulAt      DateTime?
  /// ERP 侧的最后更新时间戳(增量条件),与本地时间分开存 —— 两边时钟可能不一致
  lastExternalTimestamp String?
  /// 分页续传令牌
  pageToken             String?
  /// 执行前是否必须先预览
  requirePreview        Boolean           @default(true)
  enabled               Boolean           @default(true)
  createdById           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([tenantId, connectionId, entityType])
}

/// 同步作业
model ErpSyncJob {
  id             String           @id @default(cuid())
  tenantId       String
  connectionId   String
  connection     ErpConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType     ErpEntityType
  direction      ErpSyncDirection
  /// PREVIEW = 只算差异不写库;EXECUTE = 真正写入
  mode           String           @default("PREVIEW")
  status         JobStatus        @default(PENDING)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdCount   Int              @default(0)
  updatedCount   Int              @default(0)
  unchangedCount Int              @default(0)
  skippedCount   Int              @default(0)
  conflictCount  Int              @default(0)
  failedCount    Int              @default(0)
  /// 幂等键:同一批次重复执行不重复写入
  idempotencyKey String?
  /// 外部作业号(ERP 侧返回)
  externalJobId  String?
  requestId      String?
  errorSummary   String?
  triggeredById  String
  createdAt      DateTime         @default(now())

  /// ---- 重试(PR-D) ----
  /// 已重试次数;0 表示首次执行
  retryCount  Int       @default(0)
  /// 上限,超过即转 DEAD_LETTER 交人工
  maxRetries  Int       @default(3)
  lastRetryAt DateTime?
  /// 下次可重试时间;未到点不得重试(防止刷爆外部系统)
  nextRetryAt DateTime?

  /// ---- A-2 并发租约 ----
  /// 谁持有这次执行(userId 或 worker 标识);仅 RUNNING 期间有值
  lockedBy         String?
  lockedAt         DateTime?
  /// 租约到期时间。进程崩溃时作业会永远停在 RUNNING,
  /// 靠到期时间才能让后来者接管,而不是永久卡死
  leaseExpiresAt   DateTime?
  backoffStrategy  RetryBackoff @default(EXPONENTIAL)
  /// 重跑时指向原作业,形成重试链,便于回溯"这批到底试了几次"
  parentJobId      String?
  /// ---- 断点续跑(PR-D) ----
  /// 从第几行继续;**已成功的行不重复同步**
  resumeFromLineNo Int?
  /// 执行前后的游标,用于失败后从水位恢复而不是全量重来
  cursorBefore     String?
  cursorAfter      String?
  /// 乐观锁:并发触发同一作业时防止双写
  version          Int          @default(0)

  lines     ErpSyncJobLine[]
  conflicts ErpConflict[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, connectionId, entityType, createdAt])
  /// 调度取"到点该重试的作业"
  @@index([tenantId, status, nextRetryAt])
  @@index([tenantId, parentJobId])
}

/// 行级同步结果(预览与执行共用;预览的行 outcome 只是**预判**)
model ErpSyncJobLine {
  id            String         @id @default(cuid())
  tenantId      String
  jobId         String
  job           ErpSyncJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lineNo        Int
  /// 业务主键(如 MPN / PO+行号 / 工单号)
  bizKey        String
  outcome       ErpLineOutcome
  /// ERP 侧原值与本系统现值,便于行级差异对照
  erpValues     Json?
  localValues   Json?
  /// 差异字段清单
  changedFields Json?
  message       String?
  createdAt     DateTime       @default(now())

  /// ---- ERP 回执(PR-D)----
  /// **五种状态必须分开**,不得压成一个"成功":
  /// TEMPLATE_GENERATED(已生成模板) / SENT(已发送) / ERP_RECEIVED(ERP 已接收)
  /// / ERP_POSTED(ERP 已建单) / ERP_FAILED(ERP 拒绝)
  erpStatus     String?
  /// ERP 侧单据号与行号(回查凭据)
  erpDocumentId String?
  erpLineId     String?
  /// ERP 原始响应(脱敏后);出问题时唯一能复盘的东西
  erpResponse   Json?
  /// ERP 接收时间 ≠ 建单时间:接收只代表报文收到了
  acceptedAt    DateTime?
  postedAt      DateTime?
  /// 本行已尝试次数与最后错误(行级重试用)
  attemptCount  Int       @default(0)
  lastError     String?

  @@unique([tenantId, jobId, lineNo])
  @@index([tenantId, jobId, outcome])
  @@index([tenantId, erpDocumentId])
}

/// 冲突队列(**双向同步不按最后更新时间自动覆盖**,一律进人工队列)
model ErpConflict {
  id           String        @id @default(cuid())
  tenantId     String
  jobId        String
  job          ErpSyncJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  entityType   ErpEntityType
  bizKey       String
  field        String
  erpValue     String?
  localValue   String?
  /// 处置:ACCEPT_ERP / KEEP_LOCAL / MANUAL(人工填值);未处置为空
  resolution   String?
  manualValue  String?
  resolvedById String?
  resolvedAt   DateTime?
  note         String?
  createdAt    DateTime      @default(now())

  @@index([tenantId, jobId, resolution])
  @@index([tenantId, entityType, bizKey])
}

/// ERP 推送事件(Webhook;一期只登记不消费,便于后续接实时推送)
model ErpWebhookEvent {
  id           String    @id @default(cuid())
  tenantId     String
  connectionId String
  eventType    String
  payload      Json
  /// 幂等键:同一事件重复推送不重复处理
  externalId   String?
  processedAt  DateTime?
  error        String?
  createdAt    DateTime  @default(now())

  @@unique([tenantId, connectionId, externalId])
  @@index([tenantId, processedAt])
}

// ============================================================
// 追溯域(PR-C:批次级全链路)
//
// 数据主权与边界:本系统**没有 MES**,批次数据靠三张模板导入或 ERP 同步。
// 一期只做到**批次级**,SN 级待 MES/SN 数据接入 —— 页面必须如实标注。
// ============================================================

/// 一次导入的批次(保存原始文件 + 行级校验结果,支持撤销未关联数据的错误导入)
model TraceImportBatch {
  id             String      @id @default(cuid())
  tenantId       String
  /// RECEIPT / WO_ISSUE / SHIPMENT 三张标准模板之一
  template       String
  fileKey        String?
  fileName       String?
  source         TraceSource @default(IMPORT)
  totalRows      Int         @default(0)
  okRows         Int         @default(0)
  errorRows      Int         @default(0)
  /// 行级错误明细(行号 + 原因),不静默丢弃
  errors         Json?
  /// 幂等键:同一文件重复导入不重复建数据
  idempotencyKey String?
  /// 撤销:只允许撤销尚未被下游引用的数据
  revokedAt      DateTime?
  revokedById    String?
  createdById    String
  createdAt      DateTime    @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, template, createdAt])
}

/// 收料批次(PO → 供应商批次 → 内部批次的落点)
model ReceiptLot {
  id                 String      @id @default(cuid())
  tenantId           String
  importBatchId      String?
  poNo               String?
  poLineNo           Int?
  supplierId         String?
  supplierName       String?
  mpn                String?
  internalPn         String?
  /// 供应商批次号
  supplierLot        String?
  /// 内部批次号(与 MaterialLot.lotNo 对应)
  internalLot        String
  receivedQty        Decimal     @db.Decimal(18, 4)
  receivedAt         DateTime?
  dateCode           String?
  warehouse          String?
  location           String?
  source             TraceSource @default(IMPORT)
  /// ---- 外部来源(PR-E:真实 ERP 映射)----
  sourceSystem       String?
  sourceConnectionId String?
  /// ERP 侧主键与行号;用于幂等与回查
  externalId         String?
  externalLineId     String?
  /// ERP 侧版本号/时间戳:判断"这条是不是比我手上的新"
  externalVersion    String?
  sourceUpdatedAt    DateTime?
  createdById        String
  createdAt          DateTime    @default(now())

  @@unique([tenantId, internalLot])
  @@index([tenantId, poNo, poLineNo])
  @@index([tenantId, mpn])
  @@index([tenantId, supplierLot])
}

/// 内部物料批次(库存与发料的主体)
model MaterialLot {
  id                 String    @id @default(cuid())
  tenantId           String
  lotNo              String
  mpn                String?
  internalPn         String?
  /// 收料带入的数量;已发料/剩余由发料行派生,**不落冗余计数**
  receivedQty        Decimal   @db.Decimal(18, 4)
  /// 冻结登记:仅代表**本系统已登记**,不代表 ERP/WMS 已锁库
  frozenAt           DateTime?
  frozenById         String?
  frozenReason       String?
  /// ---- 外部来源(PR-E:真实 ERP 映射)----
  sourceSystem       String?
  sourceConnectionId String?
  /// ERP 侧主键与行号;用于幂等与回查
  externalId         String?
  externalLineId     String?
  /// ERP 侧版本号/时间戳:判断"这条是不是比我手上的新"
  externalVersion    String?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime  @default(now())

  @@unique([tenantId, lotNo])
  @@index([tenantId, mpn])
}

/// 生产工单
model TraceWorkOrder {
  id                 String      @id @default(cuid())
  tenantId           String
  workOrderNo        String
  product            String?
  bomVersion         String?
  plannedQty         Decimal?    @db.Decimal(18, 4)
  productionLine     String?
  startAt            DateTime?
  needDate           DateTime?
  status             String?
  /// 暂停登记:同样只代表本系统已登记
  pausedAt           DateTime?
  pausedById         String?
  pausedReason       String?
  /// ---- 外部来源(PR-E:真实 ERP 映射)----
  sourceSystem       String?
  sourceConnectionId String?
  /// ERP 侧主键与行号;用于幂等与回查
  externalId         String?
  externalLineId     String?
  /// ERP 侧版本号/时间戳:判断"这条是不是比我手上的新"
  externalVersion    String?
  sourceUpdatedAt    DateTime?
  source             TraceSource @default(IMPORT)
  createdAt          DateTime    @default(now())

  @@unique([tenantId, workOrderNo])
}

/// 工单发料(批次 → 工单的关键一跳)
model WorkOrderMaterialIssue {
  id                 String    @id @default(cuid())
  tenantId           String
  importBatchId      String?
  workOrderNo        String
  lotNo              String
  mpn                String?
  issuedQty          Decimal   @db.Decimal(18, 4)
  returnedQty        Decimal?  @db.Decimal(18, 4)
  issuedAt           DateTime?
  operator           String?
  /// ---- 外部来源(PR-E:真实 ERP 映射)----
  sourceSystem       String?
  sourceConnectionId String?
  /// ERP 侧主键与行号;用于幂等与回查
  externalId         String?
  externalLineId     String?
  /// ERP 侧版本号/时间戳:判断"这条是不是比我手上的新"
  externalVersion    String?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime  @default(now())

  @@unique([tenantId, workOrderNo, lotNo])
  @@index([tenantId, lotNo])
  @@index([tenantId, workOrderNo])
}

/// 成品批次
model FinishedGoodsLot {
  id                 String    @id @default(cuid())
  tenantId           String
  fgLotNo            String
  workOrderNo        String?
  product            String?
  producedQty        Decimal?  @db.Decimal(18, 4)
  producedAt         DateTime?
  /// ---- 外部来源(PR-E:真实 ERP 映射)----
  sourceSystem       String?
  sourceConnectionId String?
  /// ERP 侧主键与行号;用于幂等与回查
  externalId         String?
  externalLineId     String?
  /// ERP 侧版本号/时间戳:判断"这条是不是比我手上的新"
  externalVersion    String?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime  @default(now())

  @@unique([tenantId, fgLotNo])
  @@index([tenantId, workOrderNo])
}

/// 出货单与出货行(成品批次 → 客户)
model TraceShipment {
  id                 String    @id @default(cuid())
  tenantId           String
  shipmentNo         String
  customerId         String?
  customerName       String?
  customerPo         String?
  shippedAt          DateTime?
  /// ---- 外部来源(PR-E:真实 ERP 映射)----
  sourceSystem       String?
  sourceConnectionId String?
  /// ERP 侧主键与行号;用于幂等与回查
  externalId         String?
  externalLineId     String?
  /// ERP 侧版本号/时间戳:判断"这条是不是比我手上的新"
  externalVersion    String?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime  @default(now())

  lines TraceShipmentLine[]

  @@unique([tenantId, shipmentNo])
  @@index([tenantId, customerId])
}

model TraceShipmentLine {
  id            String        @id @default(cuid())
  tenantId      String
  shipmentId    String
  shipment      TraceShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  importBatchId String?
  fgLotNo       String
  shippedQty    Decimal       @db.Decimal(18, 4)
  createdAt     DateTime      @default(now())

  @@unique([tenantId, shipmentId, fgLotNo])
  @@index([tenantId, fgLotNo])
}

/// 追溯图的边(冗余但必要:图遍历不该每次都去 join 五张表)
model TraceEdge {
  id                 String        @id @default(cuid())
  tenantId           String
  kind               TraceEdgeKind
  /// 源与目标用「类型:业务键」表达,如 LOT:LOT-2026-001 / WO:WO-26-0412
  fromRef            String
  toRef              String
  /// 该跳的数量。**保留原字段**兼容历史数据
  qty                Decimal?      @db.Decimal(18, 4)
  /// ---- 单位换算(PR-E)----
  /// 原始数量与单位(如 2 Reel)
  quantity           Decimal?      @db.Decimal(18, 6)
  uom                String?
  /// 折算到基准单位后的值(如 10000 PCS)。
  /// **合计只能用 baseQuantity 且 baseUom 一致时相加** —— 不能把 PCS 和 Reel 直接相加
  baseQuantity       Decimal?      @db.Decimal(18, 6)
  baseUom            String?
  /// 换算系数(1 Reel = 5000 PCS 则为 5000);未知时留空,该边计入"数量不可比"
  conversionFactor   Decimal?      @db.Decimal(18, 6)
  occurredAt         DateTime?
  source             TraceSource   @default(IMPORT)
  /// ---- 外部来源(PR-E:真实 ERP 映射)----
  sourceSystem       String?
  sourceConnectionId String?
  /// ERP 侧主键与行号;用于幂等与回查
  externalId         String?
  externalLineId     String?
  /// ERP 侧版本号/时间戳:判断"这条是不是比我手上的新"
  externalVersion    String?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime      @default(now())

  @@unique([tenantId, kind, fromRef, toRef])
  @@index([tenantId, fromRef])
  @@index([tenantId, toRef])
}

/// 追溯事件时间线
model TraceEvent {
  id                 String          @id @default(cuid())
  tenantId           String
  ref                String
  /// 原自由字符串字段,**保留不动**以兼容历史数据
  eventType          String
  /// 受控枚举(PR-E);历史行为空,新写入必填
  kind               TraceEventKind?
  detail             Json?
  occurredAt         DateTime
  source             TraceSource     @default(IMPORT)
  /// ---- 外部来源(PR-E:真实 ERP 映射)----
  sourceSystem       String?
  sourceConnectionId String?
  /// ERP 侧主键与行号;用于幂等与回查
  externalId         String?
  externalLineId     String?
  /// ERP 侧版本号/时间戳:判断"这条是不是比我手上的新"
  externalVersion    String?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime        @default(now())

  @@index([tenantId, ref, occurredAt])
}

/// 批次拆分/合并(PR-E)。
///
/// 为什么必须显式建模:拆分与合并是**图的连接点**。只在 TraceEdge 加两条边,
/// 追溯能走通,但回答不了"这 3000 颗是从哪一批的哪一段拆出来的、拆时还剩多少"。
/// 拆合记录本身就是审计对象。
model LotSplitMerge {
  id                 String      @id @default(cuid())
  tenantId           String
  /// SPLIT:一进多出;MERGE:多进一出
  kind               String
  sourceLotNos       String[]
  targetLotNos       String[]
  /// 各目标批次分到的数量(与 targetLotNos 同序)
  quantities         Decimal[]   @db.Decimal(18, 6)
  uom                String?
  reason             String?
  operator           String?
  occurredAt         DateTime
  source             TraceSource @default(IMPORT)
  sourceSystem       String?
  sourceConnectionId String?
  externalId         String?
  createdById        String
  createdAt          DateTime    @default(now())

  @@index([tenantId, kind, occurredAt])
  @@index([tenantId, externalId])
}

/// 生产替代料实际使用记录(PR-E)。
///
/// **不改动已有 BOM**:BOM 记"设计要什么料",本表记"这批实际投了什么料"。
/// 两者必须分开 —— 把实际用料写回 BOM 会让历史 BOM 失真,
/// 而客诉调查恰恰需要知道"当时到底投的是哪颗"。
model TraceSubstitution {
  id                 String      @id @default(cuid())
  tenantId           String
  workOrderNo        String
  bomMpn             String?
  bomInternalPn      String?
  actualMpn          String?
  actualInternalPn   String?
  actualLotNo        String?
  quantity           Decimal?    @db.Decimal(18, 6)
  uom                String?
  /// 替代必须有人批准 —— 无批准人的替代记录本身就是异常
  approvedById       String?
  approvedAt         DateTime?
  approvalReason     String?
  source             TraceSource @default(IMPORT)
  sourceSystem       String?
  sourceConnectionId String?
  externalId         String?
  createdById        String
  createdAt          DateTime    @default(now())

  @@index([tenantId, workOrderNo])
  @@index([tenantId, actualLotNo])
  @@index([tenantId, bomMpn])
}

/// 影响面分析快照(PR-E)。
///
/// 异常调查往往持续数周,期间数据在变。
/// **不保存快照,事后没人说得清"当时是按什么数据下的隔离决定"**。
model TraceAnalysisRun {
  id              String          @id @default(cuid())
  tenantId        String
  sourceRef       String
  /// 分析基准时刻 —— 与 createdAt 分开,可按历史时点重算
  analysisAsOf    DateTime
  snapshot        Json
  /// 当时哪几段没有数据
  dataGapSnapshot Json?
  /// 便于台账直接排序,不必解快照
  confidence      TraceConfidence
  coverageScore   Int
  /// 图数据变化后可判断快照是否已过时
  inputVersion    String?
  incidentId      String?
  createdById     String
  createdAt       DateTime        @default(now())

  @@index([tenantId, sourceRef, analysisAsOf])
  @@index([tenantId, incidentId])
}

/// 质量事件(客诉 / 来料异常 / 制程异常的登记入口)
/// E6:质量事件类型(客户 Q12 明确质量事件由品质维护)
enum QualityEventType {
  INCOMING
  PROCESS
  CUSTOMER_COMPLAINT
  SUPPLIER
  TRACE_INCIDENT
  OTHER
}

model QualityIncident {
  id             String         @id @default(cuid())
  tenantId       String
  code           String
  title          String
  /// 异常源:LOT / WO / FG / SHIPMENT / PO 的业务键
  sourceRef      String
  description    String?
  severity       String?
  status         IncidentStatus @default(OPEN)
  /// E6:事件类型。默认 OTHER —— 旧数据没有分类过,不替它猜一个。
  eventType      QualityEventType @default(OTHER)
  /// 客诉挂客户、来料/供应商问题挂供应商;都可空(过程异常两个都没有)
  customerId     String?
  supplierId     String?
  partId         String?
  mpn            String?
  lotId          String?
  /// SN 级留空是**常态**:没有 MES 就没有 SN,不编一个
  sn             String?
  detectedAt     DateTime?
  ownerId        String?
  resolution     String?
  /// 关联的追溯分析(从追溯页发起时带上)
  traceAnalysisId String?
  /// 影响范围分析快照(算出来即固化,便于事后复盘)
  impactSnapshot Json?
  reportedById   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  actions ContainmentAction[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

/// 处置动作。
///
/// **状态必须区分「本系统已登记」与「外部系统已执行」** ——
/// 未接 ERP/MES 时只能到 REGISTERED_LOCALLY / PENDING_EXTERNAL,
/// 绝不显示「ERP 已冻结」「设备已停机」。
model ContainmentAction {
  id           String           @id @default(cuid())
  tenantId     String
  incidentId   String
  incident     QualityIncident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  kind         ContainmentKind
  targetRef    String
  state        ContainmentState @default(SUGGESTED)
  /// 提议与批准分离:提议人 ≠ 批准人
  proposedById String
  proposedAt   DateTime         @default(now())
  approvedById String?
  approvedAt   DateTime?
  rejectReason String?
  /// 外部系统执行结果(ERP/MES 接通后回填)
  externalRef  String?
  externalNote String?
  note         String?
  updatedAt    DateTime         @updatedAt

  @@index([tenantId, incidentId, state])
}

// ============================================================
// 8. OPO 域(行级唯一数据源)
// ============================================================

/// OPO 行级模型 —— KPI/未回复表/差异表/异常清单全部由本表查询派生,
/// 禁止落任何冗余计数字段、禁止旁路计数(CLAUDE.md OPO 规则)。
model OPOLine {
  id             String    @id @default(cuid())
  tenantId       String
  poNo           String
  lineNo         Int
  supplierId     String
  partId         String?
  mpn            String?
  qtyOrdered     Decimal   @db.Decimal(18, 4)
  qtyOpen        Decimal   @db.Decimal(18, 4)
  unitPrice      Decimal?  @db.Decimal(18, 6)
  currency       String?
  /// ERP 承诺交期
  promiseDate    DateTime?
  /// 需求日期(异常判定输入)
  needDate       DateTime?
  /// 催办 Cron 扫描游标(提前 4 天催办)
  nextReminderAt DateTime?
  /// ERP 单据引用
  erpRef         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  replies OPOReply[]

  @@unique([tenantId, poNo, lineNo])
  @@index([tenantId, supplierId])
  @@index([tenantId, nextReminderAt])
}

/// 供应商回复(五字段齐备,评审要求二.5)
model OPOReply {
  id          String      @id @default(cuid())
  tenantId    String
  opoLineId   String
  opoLine     OPOLine     @relation(fields: [opoLineId], references: [id])
  replyEta    DateTime?
  replyQty    Decimal?    @db.Decimal(18, 4)
  replyNote   String?
  replyAt     DateTime
  replySource ReplySource
  /// 回复人(供应商联系人 id 或门户用户 id,可空)
  contactId   String?
  createdAt   DateTime    @default(now())

  @@index([tenantId, opoLineId, replyAt])
}

/// 催办日志;幂等键防重发(评审要求二.9 同款纪律)
model ReminderLog {
  id             String    @id @default(cuid())
  tenantId       String
  opoLineId      String
  idempotencyKey String
  channel        String    @default("EMAIL")
  status         JobStatus @default(PENDING)
  sentAt         DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, opoLineId])
}

/// 邮件草稿(客户 docx 三项:批量发送订单 / 订单接受通知 / 供应商资料邮件直发建档)。
///
/// **邮件通道未接入** —— 本表只登记"要发什么给谁",状态止于 DRAFT/PREVIEWED,
/// 永远不会变成"已发送"。真正发送需接入邮件服务后再实现,届时新增 SENT 状态与发送记录。
/// 这与 ReminderLog 的处理方式一致:宁可少报,不可虚报。
model EmailDraft {
  id          String    @id @default(cuid())
  tenantId    String
  /// PO_DISPATCH=批量发送订单;PO_ACK=订单接受通知;SUPPLIER_ONBOARD=供应商建档邀请
  kind        String
  /// 关联单据(PO 号 / 供应商 id 等),便于回查
  refType     String?
  refId       String?
  toName      String?
  toEmail     String?
  subject     String
  body        String
  /// 附件说明(本系统只列出应附哪些文件,不代发)
  attachments Json?
  /// DRAFT=已生成草稿;PREVIEWED=已被人工预览过。**没有 SENT**
  status      String    @default("DRAFT")
  previewedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([tenantId, kind, status])
  @@index([tenantId, refType, refId])
}

/// 供应商建档邀请(客户 docx:「供应商的资料是否可以在添加供应商时由供应商直接邮件发出,
/// 点击到建立 CUSTOMER CODE 的同事处」)。
///
/// 一期:生成**邀请链接 + 邮件草稿**,供应商经链接回填资料 → 落 SupplierContact;
/// 自动解析来信属二期(InboundEmailAdapter)。
model SupplierOnboardInvite {
  id          String    @id @default(cuid())
  tenantId    String
  supplierId  String?
  /// 邀请码(URL 用);一次性、可过期
  token       String    @unique
  toEmail     String?
  companyName String?
  /// PENDING=待回填;SUBMITTED=供应商已提交;ACCEPTED=已建档
  status      String    @default("PENDING")
  /// 供应商提交的资料原文(未经采纳前不写入主数据)
  submitted   Json?
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, status])
}

// ============================================================
// F6-B:客户门户账号(设计 docs/design/F6-CHECKPOINT-A.md)
// 独立认证域:与内部 User 完全分离,无 roles、不进 SEARCH_SCOPES。
// 仅内部管理层邀请建号,无自注册路径。
// ============================================================

model PortalAccount {
  id           String    @id @default(cuid())
  tenantId     String
  customerId   String
  email        String
  passwordHash String
  active       Boolean   @default(true)
  invitedById  String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, customerId])
}

// ============================================================
// F2:ECN-Lite(设计 docs/design/F2-CHECKPOINT-A.md;页面 docs/PAGE_SPEC_ECN.md)
// 范围:登记、评审(三段固定顺序)、批准、发布(快照冻结)、Apply to BOM、作废可溯。
// 完整 ECN(流程引擎/签章/MES 指令)仍在待商务确认池。
// ============================================================

enum EcnStatus {
  DRAFT
  REVIEW
  CUSTOMER_CONFIRM
  APPROVED
  RELEASED
  CLOSED
  VOIDED
}

enum EcnType {
  DESIGN_CHANGE
  EOL_REPLACEMENT
  PROCESS_CHANGE
  DOC_CHANGE
  OTHER
}

enum EcnPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// 评审阶段:只取五角色模型内的三个内部角色,**无品质/总经理**(PAGE_SPEC §0)
enum EcnStage {
  ENGINEERING
  PROCUREMENT
  MANAGEMENT
}

enum EcnEffectiveStrategy {
  IMMEDIATE
  AFTER_WORK_ORDERS
  ON_DATE
}

model Ecn {
  id       String      @id @default(cuid())
  tenantId String
  /// ECN 编号(租户内唯一)
  code     String
  title    String
  type     EcnType
  priority EcnPriority @default(MEDIUM)
  status   EcnStatus   @default(DRAFT)

  customerId  String?
  productName String?
  reason      String?
  /// 生效策略由**人工选择**;AI 推荐只是建议卡,不写入
  effectiveStrategy EcnEffectiveStrategy?
  effectiveAt       DateTime?
  dueDate           DateTime?

  submittedAt DateTime?
  /// 发布即冻结:头 + 行 + 审批史的 Json 快照(与 Quote 快照同模式),此后只读
  releasedSnapshot Json?
  releasedAt       DateTime?
  releasedById     String?

  voidReason String?
  voidedAt   DateTime?
  voidedById String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  changeLines     EcnChangeLine[]
  approvals       EcnApproval[]
  customerNotices EcnCustomerNotice[]

  @@unique([tenantId, code])
  @@index([tenantId, status, priority])
  @@index([tenantId, customerId])
}

model EcnChangeLine {
  id       String @id @default(cuid())
  tenantId String
  ecnId    String
  ecn      Ecn    @relation(fields: [ecnId], references: [id])
  lineNo   Int

  /// 影响 BOM/版本(跨聚合标量)
  bomId        String?
  bomVersionId String?

  oldInternalPn String?
  oldMpn        String?
  newInternalPn String?
  newMpn        String?
  /// 数量影响(正=增用,负=减用);未知留空不填 0
  qtyImpact Decimal? @db.Decimal(18, 4)

  reason          String?
  engineeringNote String?
  /// 采购备注(库存处置决策也记这里,PAGE_SPEC §7)
  procurementNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, ecnId, lineNo])
}

model EcnApproval {
  id       String   @id @default(cuid())
  tenantId String
  ecnId    String
  ecn      Ecn      @relation(fields: [ecnId], references: [id])
  stage    EcnStage
  /// APPROVED / REJECTED
  decision  String
  comment   String?
  decidedById String
  decidedAt   DateTime @default(now())

  @@index([tenantId, ecnId, decidedAt])
}

/// T2(flag ecn.customerNotice):每客户一条告知记录。
/// 「合同条款」只是自由文本备注 —— **不建合同模型**;发送经既有 OutboundMessage,不伪造。
model EcnCustomerNotice {
  id         String  @id @default(cuid())
  tenantId   String
  ecnId      String
  ecn        Ecn     @relation(fields: [ecnId], references: [id])
  customerId String
  required   Boolean @default(false)
  contractNote String?
  /// DRAFT / SENT / REPLIED —— SENT 只能由真实发送写入
  status            String    @default("DRAFT")
  expectedReplyAt   DateTime?
  outboundMessageId String?
  updatedById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, ecnId, customerId])
}

// ============================================================
// F3:供应商免登录确认链路(设计见 docs/design/F3-CHECKPOINT-A.md)
// ============================================================

enum SupplierActionKind {
  PO_CONFIRM
  OPO_ETA
  /// 进枚举但本轮创建接口暂拒(无落地页不生成死链)
  CALL_MATERIAL
  RFQ_QUOTE
}

enum SupplierActionStatus {
  PENDING
  RESPONDED
  EXPIRED
  REVOKED
}

/// 免登录确认请求。**原始 token 不入库**,只存 SHA-256;单次响应,条件更新防重放。
model SupplierActionRequest {
  id         String               @id @default(cuid())
  tenantId   String
  kind       SupplierActionKind
  supplierId String
  /// 关联实体(PO_CONFIRM=purchaseOrderId;OPO_ETA=supplierId,行集在响应时快照)
  relatedEntityType String
  relatedEntityId   String
  tokenHash  String               @unique
  expiresAt  DateTime
  status     SupplierActionStatus @default(PENDING)

  respondedAt       DateTime?
  /// 响应人自述(记录用,不作身份凭据)
  respondedByName   String?
  respondedByEmail  String?
  responsePayload   Json?
  responseIp        String?
  responseUa        String?

  note        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, kind, status])
  @@index([tenantId, relatedEntityId])
}

/// 订单接受通知(客户 docx:「订单接受通知」)。
/// 供应商确认收到并接受订单的登记;来源可以是邮件回复人工登记,或经邀请链接自助确认。
model PoAcknowledgement {
  id           String   @id @default(cuid())
  tenantId     String
  poNo         String
  supplierId   String
  /// ACCEPTED / REJECTED / PARTIAL
  decision     String
  note         String?
  /// 登记渠道:EMAIL_MANUAL / PORTAL / PHONE
  source       String   @default("EMAIL_MANUAL")
  recordedById String
  recordedAt   DateTime @default(now())

  @@unique([tenantId, poNo, supplierId])
  @@index([tenantId, poNo])
}

// ============================================================
// 9. 智能体域(SPEC §13;全部为本系统新增)
// ============================================================

/// AgentRun 记录 SPEC §13 全部要素:输入/工具/证据/输出/人工确认/写入结果/失败/token 成本/时间
model AgentRun {
  id             String    @id @default(cuid())
  tenantId       String
  agentType      AgentType
  status         JobStatus @default(PENDING)
  idempotencyKey String?
  userId         String
  input          Json
  /// 模型最终输出(建议/草稿;正式写入须经 AgentApproval)
  output         Json?
  /// 最终写入结果引用(entityType/entityId 列表)
  writtenRefs    Json?
  error          String?
  /// token 用量与成本(promptTokens/completionTokens/costUsd)
  tokenUsage     Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  steps     AgentStep[]
  evidences AgentEvidence[]
  approvals AgentApproval[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, agentType, createdAt])
}

model AgentStep {
  id         String    @id @default(cuid())
  tenantId   String
  agentRunId String
  agentRun   AgentRun  @relation(fields: [agentRunId], references: [id])
  stepNo     Int
  /// 工具名(读工具自动执行;写工具必须经确认卡片)
  toolName   String?
  input      Json?
  output     Json?
  status     JobStatus @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([tenantId, agentRunId, stepNo])
}

/// 外部数据证据(候选/报价/库存等原始依据,支撑可追溯)
model AgentEvidence {
  id         String        @id @default(cuid())
  tenantId   String
  agentRunId String
  agentRun   AgentRun      @relation(fields: [agentRunId], references: [id])
  stepId     String?
  source     ProviderType?
  uri        String?
  payload    Json
  fetchedAt  DateTime      @default(now())

  @@index([tenantId, agentRunId])
}

/// 写工具确认卡片记录(人工批准后才执行写入)
model AgentApproval {
  id          String           @id @default(cuid())
  tenantId    String
  agentRunId  String
  agentRun    AgentRun         @relation(fields: [agentRunId], references: [id])
  stepId      String?
  toolName    String
  /// 确认卡片展示的拟写入内容
  payload     Json
  status      ApprovalDecision @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([tenantId, agentRunId])
}

// ============================================================
// 10. 平台域
// ============================================================

/// 审计日志(评审要求二.7 全字段;每个写操作必录)
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
}

/// 集成作业(失败重试;ERP Excel 模板兜底路径)
model IntegrationJob {
  id             String             @id @default(cuid())
  tenantId       String
  type           IntegrationJobType
  status         JobStatus          @default(PENDING)
  idempotencyKey String?
  payload        Json
  attempts       Int                @default(0)
  lastError      String?
  nextRetryAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, nextRetryAt])
}

/// F4:实体级同步状态。
///
/// 与既有两层的分工(**扩展而非重复**):
/// - `ErpSyncJob` / `ErpSyncJobLine` = **一次批量作业**跑得怎么样(预览/执行、行级差异);
/// - `IntegrationJob` = 轻量任务队列(模板导出、催办等一次性动作);
/// - 本表 = **某个业务对象**当前与 ERP 的对齐状态(这张 PO 回写到哪一步了)。
///   KPI、状态页、重试入口都从这里读 —— 不从作业日志里反推。
///
/// 状态语义(诚实 UI 的依据):
/// - NOT_CONFIGURED:租户没配 ERP,**不是失败也不是成功**;
/// - BLOCKED:重试解决不了(凭据过期/单据冲突),必须人工处置;
/// - RETRY_REQUIRED:瞬态失败(限流/超时/断网),可重试,**幂等键不变**。
enum IntegrationSyncState {
  NOT_CONFIGURED
  READY
  PENDING
  SYNCING
  SYNCED
  FAILED
  RETRY_REQUIRED
  BLOCKED
}

model IntegrationSyncRecord {
  id         String               @id @default(cuid())
  tenantId   String
  /// 目标系统(ErpVendor 字符串;ERP_LAB=仿真环境,UI 不得显示为「金蝶已联调」)
  provider   String
  entityType ErpEntityType
  /// 本系统侧业务对象 id;数据集级拉取(物料/库存/Excess…)用固定值 "dataset"
  entityId   String
  direction  ErpSyncDirection
  state      IntegrationSyncState @default(NOT_CONFIGURED)

  /// ERP 侧对象 id 与单据号(回查凭据;也是 ExternalEntityMapping 的等价物)
  externalId         String?
  externalDocumentNo String?

  /// 幂等键:**首次生成后不再变**,重试必须复用 —— 这是"提交后断网"不重复建单的唯一保证
  idempotencyKey String?

  attemptCount  Int       @default(0)
  errorCode     String?
  errorMessage  String?
  /// ERP 侧数据时间(读取方向);与本地时间分开存
  sourceUpdatedAt DateTime?
  /// 成功那一刻发出去/拉回来的内容快照 —— 事后对账用,不再从活数据反推
  syncedSnapshot Json?
  lastAttemptAt  DateTime?
  syncedAt       DateTime?
  nextRetryAt    DateTime?
  /// 附注(如 PARTIAL_RESPONSE 拉取的行数、FX 占位说明)
  note String?
  /// closed-loop P1-10:关联 id —— 业务动作→本记录→Lab 请求日志 一条链
  correlationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 唯一集成键:同一对象对同一方向只有一条状态记录,并发 upsert 不产生第二条
  @@unique([tenantId, provider, entityType, entityId, direction])
  @@index([tenantId, state, nextRetryAt])
  @@index([tenantId, entityType, state])
}

/// 外部 API 用量日志(DigiKey/Mouser 限流与配额观测,记录 X-RateLimit)
model ApiUsageLog {
  id                 String       @id @default(cuid())
  tenantId           String
  provider           ProviderType
  endpoint           String
  statusCode         Int?
  rateLimitLimit     Int?
  rateLimitRemaining Int?
  durationMs         Int?
  createdAt          DateTime     @default(now())

  @@index([tenantId, provider, createdAt])
}

/// 报价责任拆分(客户 PR2-PM-06:报价由多方分头填,PM 派工)。
enum QuoteTaskKind {
  MATERIAL
  NRE
  LABOR
  OTHER
}

enum QuoteTaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
}

/// 报价分项任务:PM 派工 → 承接方填报 → **直接回报价,不走审批**(客户 Q6 答复)。
model QuoteComponentTask {
  id               String          @id @default(cuid())
  tenantId         String
  quoteId          String
  quote            Quote           @relation(fields: [quoteId], references: [id])
  /// 派工时锁定的报价版本 —— 版本换了要重新派,免得填到旧版上
  quoteVersionId   String
  kind             QuoteTaskKind
  title            String
  /// 派给哪个角色(PM/ENGINEERING/PROCUREMENT…);具体到人可空
  assignedRole     String
  assignedToUserId String?
  /// 是否为**提交报价前必须完成**的关键项。默认 false ——
  /// 阻塞规则由派工人显式勾选,系统不替业务发明"什么算关键"。
  required         Boolean         @default(false)
  status           QuoteTaskStatus @default(PENDING)
  note             String?
  createdById      String
  createdAt        DateTime        @default(now())
  submittedAt      DateTime?
  submittedById    String?
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, quoteId])
  @@index([tenantId, status])
}

/// NRE 项目字典(客户 Q6:「NRE 项由客户提供标准清单、设为可选、要有备注项」)。
/// **可配置而非硬编码** —— 客户的标准清单还没给(C4),先给维护入口,
/// 空表时页面明说「尚未维护」,不塞几条我们自己编的项目冒充标准。
model NreItemDefinition {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  /// 默认金额;**可空**,没给默认值时填报处留空而不是显示 0
  defaultAmount Decimal? @db.Decimal(18, 4)
  currency      String   @default("CNY")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

/**
 * E1a(客户 Q13:「正常 BOM 导入,AI 无法全部识别,数据会丢失」)。
 * 每一条 = 上传文件里表头之后的**一行原始数据**,连同它的去向。
 * 在此之前解析器用 5 个 `continue` 悄悄丢行,100 行进去 92 行出来,
 * 没人说得清另外 8 行去哪了。
 * 这张表的意义不是"把丢掉的行捡回来"—— 空行确实不该变成物料 ——
 * 而是**让每一行都有一个可以复核的去向**。AI 与启发式规则可以判断,
 * 但**不能决定某一行不存在**。
 */
model RawBomRow {
  id                  String       @id @default(cuid())
  tenantId            String
  importJobId         String
  importJob           BOMImportJob @relation(fields: [importJobId], references: [id])
  /// 源文件行号(1 基,与 ParsedBomLine.sourceRow 同口径)
  sourceRow           Int
  /// 原始单元格原文 —— 人要能在界面上核对"这一行长什么样"
  cells               Json
  /// RowDisposition:RECOGNIZED / MERGED_INTO_PREVIOUS / BLANK /
  /// REPEATED_HEADER / PAGE_FOOTER / NO_IDENTIFIER / INSUFFICIENT
  disposition         String
  /// 人话原因,直接显示给用户
  reason              String
  /// 成为第几条 BOM 行(仅 RECOGNIZED)
  lineNo              Int?
  /// 并进了哪一行(仅 MERGED_INTO_PREVIOUS)
  mergedIntoSourceRow Int?
  createdAt           DateTime     @default(now())

  @@unique([tenantId, importJobId, sourceRow])
  @@index([tenantId, importJobId, disposition])
}


/// E6:SN 级追溯的**数据模型准备**(客户 Q12:「最好 SN 级别,但 SN 需要和 MES 关联」)。
///
/// 明确不声称已完成:本系统没有 MES,也**不产生 SN**。
/// 这张表只在客户导入 SN ↔ 工单/批次 对应关系时才有数据;
/// 没有 MES 时它就是空的,界面显示「当前粒度:批次级」。
/// **绝不自动生成虚构 SN。**
model FinishedGoodsSerial {
  id             String   @id @default(cuid())
  tenantId       String
  sn             String
  /// 该 SN 属于哪一批成品(批次级追溯的锚点)
  finishedLotId  String?
  workOrderId    String?
  productId      String?
  /// MES 侧主键 —— 回查时要能对回去
  mesExternalId  String?
  /// 数据来自哪里:MES_IMPORT / MANUAL。没有第三种 —— 系统不生成 SN
  source         String   @default("MES_IMPORT")
  createdAt      DateTime @default(now())

  @@unique([tenantId, sn])
  @@index([tenantId, finishedLotId])
  @@index([tenantId, workOrderId])
}


/// E7:外发邮件(客户 Q3:发送 = 公司 SMTP;回执 = 已读回执)。
///
/// **发送与已读是两件事,必须分开存。** 客户选了「已读回执」,
/// 而已读回执依赖收件方客户端配合,Outlook / Gmail 默认会询问或直接拒绝 ——
/// 拿不到是常态。把 SENT 当成 READ 会让采购以为供应商看过了,
/// 而实际上对方可能根本没打开。
enum OutboundMessageState {
  DRAFT
  QUEUED
  SENT
  DELIVERY_FAILED
}

model OutboundMessage {
  id           String               @id @default(cuid())
  tenantId     String
  /// 业务场景:SUPPLIER_RFQ / PO / CALL_MATERIAL / OPO_REMINDER
  kind         String
  /// 关联单据,便于回查
  refType      String?
  refId        String?
  subject      String
  body         String
  state        OutboundMessageState @default(DRAFT)
  /// 是否请求已读回执(Disposition-Notification-To)
  readReceiptRequested Boolean      @default(false)
  /// **收到**已读回执的时间。为空**不等于**对方没看 —— 多数客户端不回
  readReceiptReceivedAt DateTime?
  /// 追踪像素被加载的时间(如启用)。同样只是弱证据
  openTrackedAt DateTime?
  queuedAt     DateTime?
  sentAt       DateTime?
  /// 发送失败原因原文,直接显示给用户
  failureReason String?
  /// SMTP 侧消息 id,排查时要对得上
  providerMessageId String?
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  recipients MessageRecipient[]
  attachments MessageAttachment[]
  events     MessageDeliveryEvent[]

  @@index([tenantId, kind, state])
}

model MessageRecipient {
  id        String          @id @default(cuid())
  tenantId  String
  messageId String
  message   OutboundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// TO / CC / BCC
  field     String          @default("TO")
  email     String
  name      String?
  createdAt DateTime        @default(now())

  @@index([tenantId, messageId])
}

model MessageAttachment {
  id        String          @id @default(cuid())
  tenantId  String
  messageId String
  message   OutboundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  /// 走 FileStorageProvider 的存储键
  fileKey   String
  sizeBytes Int?
  createdAt DateTime        @default(now())

  @@index([tenantId, messageId])
}

/// 投递事件流水。**append-only**:状态怎么变的要能复盘,
/// 只留最终状态的话,"什么时候失败的、重试过几次"就查不出来了。
model MessageDeliveryEvent {
  id        String          @id @default(cuid())
  tenantId  String
  messageId String
  message   OutboundMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// QUEUED / SENT / DELIVERY_FAILED / READ_RECEIPT_RECEIVED / OPEN_TRACKED
  event     String
  detail    String?
  createdAt DateTime        @default(now())

  @@index([tenantId, messageId])
}


/// E8:汇率(客户 Q8:「ERP 系统有汇率显示,请引用」)。
///
/// **不再找外部汇率 API** —— 客户已明确来源是 ERP。
/// 在拿到金蝶接口与口径之前(O1/O3),这张表只会由人工导入填充,
/// 且换算结果一律标注为「换算参考价」,不冒充供应商正式报价。
model FxRate {
  id             String   @id @default(cuid())
  tenantId       String
  sourceCurrency String
  targetCurrency String
  /// 汇率值。字符串保精度 —— 汇率参与金额换算,绝不走浮点
  rate           Decimal  @db.Decimal(18, 8)
  /// 汇率类型(即期/月度锁定/集团内部价…),ERP 原文;口径待客户明确
  rateType       String?
  effectiveDate  DateTime
  /// KINGDEE / MANUAL。**没有第三种** —— 系统不自行推算汇率
  source         String   @default("MANUAL")
  sourceUpdatedAt DateTime?
  fetchedAt      DateTime @default(now())
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([tenantId, sourceCurrency, targetCurrency, effectiveDate, rateType])
  @@index([tenantId, sourceCurrency, targetCurrency])
}


/// F1:租户级配置与 feature flag(产品化基座,KICKOFF Round2)。
///
/// 单表 + JSON,而不是每个开关一列:开关会随 F2/F6/F7 持续增加,
/// 每加一个开关跑一次 migration 不值得。结构与默认值由
/// lib/domain/tenant-settings.ts 的 zod schema 把关 —— **读取时合并默认值**,
/// 未知键忽略,坏值回落默认并在读取结果里标注,不让一条脏配置搞垮整租户。
model TenantSettings {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  settings    Json
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
