# ==== 部署 ====
# 子路径部署(融合钉子,如挂 ezPLM 域名反代时设为 /scm);留空=根路径
NEXT_PUBLIC_BASE_PATH=
# Docker standalone 构建开关(Vercel 部署不设)
BUILD_STANDALONE=

# ==== 数据库(连接串仅存服务端,经 prisma.config.ts 读取)====
# 本地开发库:pnpm db:start(Homebrew postgresql@17,项目内 .pgdata,端口 5433)
DATABASE_URL="postgresql://postgres@localhost:5433/ezplm_scm_dev"

# ==== 认证(PR2)====
# 会话 JWT 签名密钥(HS256);生产必须更换为强随机值
AUTH_SECRET="change-me"
# ezPLM SSO 验签公钥 —— 状态:待联调(整合方案 7.3),配置后 EzplmJwtVerifierAdapter 才启用
# EZPLM_JWT_PUBLIC_KEY=

# ==== 文件存储(PR2)====
# local(开发/私有化)| vercel-blob(需 BLOB_READ_WRITE_TOKEN,状态:待授权)
FILE_STORAGE_PROVIDER="local"
# FILE_STORAGE_DIR=".storage"
# BLOB_READ_WRITE_TOKEN=

# ==== 种子 ====
# SEED_DEMO_PASSWORD="demo1234"

# ==== ezPLM Provider(SPEC §7;二者齐备走 Http,否则 Mock;状态:待联调)====
# EZPLM_API_BASE_URL=
# EZPLM_API_KEY=

# ==== DigiKey Provider(SPEC §8;真实值仅填入 .env.local,严禁入库)====
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
# DIGIKEY_ACCOUNT_ID=
# DIGIKEY_SITE=CN
# DIGIKEY_LANGUAGE=zh
# DIGIKEY_CURRENCY=CNY

# ==== Mouser Provider(SPEC §9;真实值仅填入 .env.local,严禁入库)====
# MOUSER_API_KEY=
# MOUSER_API_BASE_URL=https://api.mouser.com

# ==== 定时任务(PR8)====
# CRON_SECRET=

# ==== 智能体(PR7)====
# 未配置时使用 MockQuoteAgent(本地规则建议),UI 如实标注「未接入模型」
# ANTHROPIC_API_KEY=

# ==== DigiKey 沙箱 ====
# Sandbox 凭据必须同时设置以下 Base URL,否则会 401
# DIGIKEY_API_BASE_URL=https://sandbox-api.digikey.com

# ==== 容器部署(PR9)====
# 设 1 跳过容器启动时的 prisma migrate deploy
# SKIP_MIGRATIONS=

# ==== AI 模型(统一接入层 lib/ai;真实 Key 仅填入 .env.local,严禁入库)====
# 供两处功能使用:① 报价 QuoteAgent 的分类/Markup 建议 ② 图片/扫描件 BOM 转写。
# 选型顺序:AI_PROVIDER 显式指定 > GEMINI_API_KEY > ANTHROPIC_API_KEY > 无(降级为本地规则)。
# 纪律:模型只给建议参数与转写文本,金额一律由确定性函数计算;写操作只产出待确认提案。
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# 强制指定厂商:gemini | anthropic | none(none=关闭 AI,全部走本地规则)
# AI_PROVIDER=

# ==== 租户隔离拦截器(R0-5)====
# 数据层对每次 update/delete/updateMany/deleteMany/upsert 检查 where 是否带租户谓词。
# 默认**只报不拦**(console.warn + 计数);设 1 切为抛错。
# 切拦截前需先收敛存量站点(清单见 PR #90 描述)。
# TENANT_SCOPE_ENFORCE=

# ==== 重构期迁移开关(REF-0.8;迁移完成即连同旧实现一起删除)====
# 这些是**部署期脚手架**,不是业务功能开关 —— 故意不进 TenantSettings。
# 默认全关;只认 1/true/on/yes(大小写不敏感),认不出的值一律当关。
# 用法见 docs/refactor/MIGRATION_PLAN.md §2:旧实现始终是生产结果,
# 新实现经 shadowRun 后台对拍,差异清零且无 NEXT_FAILED 才可 flip。
# REFACTOR_PART_IDENTITY_V2=
# REFACTOR_BOM_NORMALIZER_V2=
# REFACTOR_SUPPLIER_MAPPING_V2=
# REFACTOR_ALTERNATE_ENGINE_V2=
