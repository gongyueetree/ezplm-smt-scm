{
  "name": "ezplm-smt-scm",
  "version": "0.1.0",
  "private": true,
  "description": "ezPLM AI 供应链协同系统(乾创电子)— Next.js 全栈重构",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "smoke:external": "tsx scripts/smoke-external.ts",
    "predev": "node scripts/copy-occt.mjs",
    "prebuild": "node scripts/copy-occt.mjs && prisma generate",
    "smoke:ai": "tsx scripts/smoke-ai.ts",
    "seed:parts": "tsx scripts/seed-parts-from-ezplm.ts",
    "seed:remote": "sh scripts/seed-remote.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "^7.9.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.4",
    "next": "^15.3.0",
    "occt-import-js": "^0.0.23",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.52.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.0",
    "prisma": "7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@10.28.2"
}
